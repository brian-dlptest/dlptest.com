# Static redirects evaluated by the Cloudflare Workers Assets layer.
#
# These MUST live here (not in src/middleware.ts): Workers Assets serves static
# files / the 404 for any path that isn't a real Astro route WITHOUT invoking
# the Worker, so middleware never runs for these paths in production. The Assets
# layer DOES honor this file (same mechanism as public/_headers).
#
# Format: <from>  <to>  <status>

