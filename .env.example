# Local-only credentials used by ./scripts/upload-large.mjs
# Copy this to .env (which is gitignored) and fill in the values.
#
# How to generate:
#   1. https://dash.cloudflare.com → R2 → "Manage R2 API tokens"
#   2. Create Account API Token → "Object Read & Write" → specific bucket
#      "dlptest-downloads" → copy values into the fields below.
#
# These credentials only grant read/write on the one R2 bucket and are
# never sent to or used by the Worker at runtime — the Worker uses the
# DOWNLOADS binding configured in wrangler.jsonc instead.

R2_ACCOUNT_ID=3210a4eb0e2a9c264f1584cd27674cd8
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=dlptest-downloads

# Subscribe form (Contacts API on Railway) — also set in Cloudflare Pages env
PUBLIC_SUBSCRIBE_API_URL=https://dlp-test-subscribe-email-database-production.up.railway.app/api/contacts
PUBLIC_SUBSCRIBE_API_KEY=
