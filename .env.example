# Local-only credentials used by ./scripts/upload-large.mjs
# Copy this to .env (which is gitignored) and fill in the values.
#
# How to generate:
#   1. https://dash.cloudflare.com → R2 → "Manage R2 API tokens"
#   2. Create Account API Token → "Object Read & Write" → specific bucket
#      "dlptest-downloads" → copy values into the fields below.
#
# These credentials only grant read/write on the one R2 bucket and are
# never sent to or used by the Worker at runtime — the Worker uses the
# DOWNLOADS binding configured in wrangler.jsonc instead.

R2_ACCOUNT_ID=3210a4eb0e2a9c264f1584cd27674cd8
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=dlptest-downloads

# Subscribe form — used by /api/subscribe/ server proxy (Worker runtime, never
# exposed to the browser). Read via the cloudflare:workers env binding, NOT
# inlined into the build. In production set as secrets:
#   npx wrangler secret put SUBSCRIBE_API_KEY            (+ --env staging)
# SUBSCRIBE_API_URL is optional — code defaults to the Railway upstream; only
# set it to point at a different upstream.
SUBSCRIBE_API_URL=https://dlp-test-subscribe-email-database-production.up.railway.app/api/contacts
SUBSCRIBE_API_KEY=

# Contact form — Microsoft Graph (Office 365 / Exchange Online) via the OAuth2
# client-credentials flow. CONTACT_* are wrangler vars; the GRAPH_* values are
# secrets, set per Worker:
#   npx wrangler secret put GRAPH_TENANT_ID      (+ --env staging)
#   npx wrangler secret put GRAPH_CLIENT_ID       (+ --env staging)
#   npx wrangler secret put GRAPH_CLIENT_SECRET   (+ --env staging)
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=contact@dlptest.com
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# Feedback form — Cloudflare Turnstile CAPTCHA
# Create a site at: https://dash.cloudflare.com/ → Turnstile
# For local testing use the always-pass test keys:
#   site key:   1x00000000000000000000AA
#   secret key: 1x0000000000000000000000000000000AA
CF_TURNSTILE_SITE_KEY=1x00000000000000000000AA
CF_TURNSTILE_SECRET_KEY=

# GitHub PAT for creating issues on brian-dlptest/dlptest.com
# Scopes needed: public_repo (or repo for private)
# Set as a secret: npx wrangler secret put GITHUB_TOKEN
GITHUB_TOKEN=
