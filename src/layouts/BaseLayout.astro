---
import "@/styles/global.css";
import SiteAnalytics from "@/components/SiteAnalytics.astro";
import SiteHeader, { type HeaderNavItem } from "@/components/SiteHeader.astro";
import ThemeToggle from "@/components/ThemeToggle.astro";
import { GTM_CONTAINER_ID } from "@/lib/analytics";
import { env } from "cloudflare:workers";
import { THEME_STORAGE_KEY } from "@/lib/theme";

interface Props {
  title: string;
  description?: string;
  /** When true, force noindex even outside staging (e.g. a thank-you page). */
  noindex?: boolean;
}

const { title, description = "DLP Test — a resource for testing Data Loss Prevention software.", noindex = false } = Astro.props;

// `env.ENVIRONMENT` is set per-Worker via wrangler.jsonc (`production` vs
// `staging`). Pages prerendered at build time bake in this value, so a
// staging build correctly shows the banner and emits noindex tags.
const isStaging = env.ENVIRONMENT === "staging";
const shouldNoindex = noindex || isStaging;
/** GTM/GA4 only on production so staging traffic does not pollute reports. */
const analyticsEnabled = env.ENVIRONMENT === "production";
const canonical = new URL(Astro.url.pathname, "https://dlptest.com").toString();
const currentPath = Astro.url.pathname.replace(/\/+$/, "") || "/";

const nav: Array<{ href: string; label: string }> = [
  { href: "/", label: "Home" },
  { href: "/sample-data/", label: "Sample Data Library" },
  { href: "/generate/", label: "Data Generator" },
  { href: "/http-post/", label: "HTTP POST Test" },
  { href: "/ftp-test/", label: "FTP Test" },
  { href: "/blog/", label: "Blog" },
  { href: "/contact/", label: "Contact" },
];

// Known top-level routes. Blog posts (news + guides) live at /<slug>/ (legacy
// WordPress permalinks); anything not in this set that arrives as a single path
// segment is treated as a blog post for the purpose of highlighting the Blog nav.
const TOP_LEVEL_PATHS = new Set<string>([
  "/",
  "/sample-data",
  "/http-post",
  "/ftp-test",
  "/blog",
  "/contact",
  "/privacy-policy",
  "/terms-and-conditions",
  "/generate",
]);

function isActive(href: string) {
  const normHref = href.replace(/\/+$/, "") || "/";
  if (normHref === currentPath) return true;
  if (
    normHref === "/blog" &&
    currentPath.startsWith("/") &&
    !TOP_LEVEL_PATHS.has(currentPath)
  ) {
    return true;
  }
  return false;
}

const headerNav: HeaderNavItem[] = nav.map((item) => ({
  ...item,
  active: isActive(item.href),
}));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — DLP Test</title>
    <meta name="description" content={description} />
    {shouldNoindex ? (
      <>
        <meta name="robots" content="noindex, nofollow, noarchive, nosnippet, noimageindex, notranslate" />
        <meta name="googlebot" content="noindex, nofollow" />
      </>
    ) : (
      <link rel="canonical" href={canonical} />
    )}
    <link rel="icon" type="image/png" href="/favicon.png" sizes="150x150" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script is:inline define:vars={{ themeKey: THEME_STORAGE_KEY }}>
      (function () {
        try {
          var t = localStorage.getItem(themeKey);
          if (t === "light" || t === "dark") document.documentElement.dataset.theme = t;
        } catch (e) {}
      })();
    </script>
    <SiteAnalytics enabled={analyticsEnabled} />
  </head>
  <body>
    {analyticsEnabled && (
      <noscript>
        <iframe
          src={`https://www.googletagmanager.com/ns.html?id=${GTM_CONTAINER_ID}`}
          height="0"
          width="0"
          style="display:none;visibility:hidden"
          title="Google Tag Manager"
        />
      </noscript>
    )}
    {isStaging && (
      <div class="staging-banner">
        STAGING — content is not indexed and may differ from production.
      </div>
    )}
    <SiteHeader nav={headerNav} />
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="site-footer-inner">
        <div class="site-footer-start">
          <div>&copy; {new Date().getFullYear()} DLP Test. Created by Brian Hileman.</div>
          <div class="site-footer-links">
          <a href="/privacy-policy/">Privacy</a>
          {" · "}
          <a href="/terms-and-conditions/">Terms</a>
          {" · "}
          <a href="/contact/">Contact</a>
          </div>
        </div>
        <ThemeToggle />
      </div>
    </footer>
  </body>
</html>
