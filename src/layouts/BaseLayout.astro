---
import "@/styles/global.css";
import SiteAnalytics from "@/components/SiteAnalytics.astro";
import SiteHeader, { type HeaderNavItem } from "@/components/SiteHeader.astro";
import SubscribeModal from "@/components/SubscribeModal.astro";
import ThemeToggle from "@/components/ThemeToggle.astro";
import FeedbackModal from "@/components/FeedbackModal.astro";
import { GTM_CONTAINER_ID } from "@/lib/analytics";
import { env } from "cloudflare:workers";
import { THEME_STORAGE_KEY } from "@/lib/theme";

interface Props {
  title: string;
  description?: string;
  /** When true, force noindex even outside staging (e.g. a thank-you page). */
  noindex?: boolean;
  /** Open Graph type — pages default to "website"; blog posts pass "article". */
  ogType?: "website" | "article";
  /** Article dates, emitted as article:* meta when ogType is "article". */
  publishedTime?: Date;
  modifiedTime?: Date;
  /** Path to the social-preview image (1200×630). Defaults to the site-wide card. */
  ogImage?: string;
}

const {
  title,
  description = "DLP Test — a resource for testing Data Loss Prevention software.",
  noindex = false,
  ogType = "website",
  publishedTime,
  modifiedTime,
  ogImage = "/og-default.png",
} = Astro.props;

// Titles that already lead with the brand (e.g. the homepage's
// "DLP Test — Test Your Data Loss Prevention") skip the suffix so the
// rendered <title> doesn't double up as "DLP Test — … — DLP Test".
const fullTitle =
  title === "DLP Test" || title.startsWith("DLP Test — ")
    ? title
    : `${title} — DLP Test`;

// `env.ENVIRONMENT` is set per-Worker via wrangler.jsonc (`production` vs
// `staging`). Pages prerendered at build time bake in this value, so a
// staging build correctly shows the banner and emits noindex tags.
const isStaging = env.ENVIRONMENT === "staging";
const shouldNoindex = noindex || isStaging;
/** GTM/GA4 only on production so staging traffic does not pollute reports. */
const analyticsEnabled = env.ENVIRONMENT === "production";
const canonical = new URL(Astro.url.pathname, "https://dlptest.com").toString();
const ogImageUrl = new URL(ogImage, "https://dlptest.com").toString();
const currentPath = Astro.url.pathname.replace(/\/+$/, "") || "/";

// Site-level structured data, emitted on the homepage only — search engines
// pick up Organization/WebSite from any page, and once is enough.
const siteJsonLd =
  currentPath === "/"
    ? JSON.stringify([
        {
          "@context": "https://schema.org",
          "@type": "Organization",
          "@id": "https://dlptest.com/#organization",
          name: "DLP Test",
          url: "https://dlptest.com/",
          logo: "https://dlptest.com/dlp-test-logo.png",
        },
        {
          "@context": "https://schema.org",
          "@type": "WebSite",
          "@id": "https://dlptest.com/#website",
          name: "DLP Test",
          url: "https://dlptest.com/",
          description:
            "Free testing resources for Data Loss Prevention (DLP) software — sample data, HTTP POST test endpoints, a public FTP server, a regex workbench, and an MCP server.",
          publisher: { "@id": "https://dlptest.com/#organization" },
        },
      ])
    : null;

// Top level keeps the most-visited pages front and center (per GA4 the two
// POST test pages dominate traffic); everything else lives under the
// "Extra Tools" dropdown.
type NavLink = { href: string; label: string };
const nav: Array<NavLink | { label: string; children: NavLink[] }> = [
  { href: "/", label: "Home" },
  { href: "/sample-data/", label: "Sample Data" },
  { href: "/http-post/", label: "HTTP Post" },
  { href: "/https-post/", label: "HTTPS Post" },
  {
    label: "Extra Tools",
    // Keep children in alphabetical order by label when adding tools.
    children: [
      { href: "/generate/", label: "Data Generator" },
      { href: "/ftp-test/", label: "FTP & S3 Test" },
      { href: "/mcp/", label: "MCP Server" },
      { href: "/regex/", label: "Regex Test" },
    ],
  },
  // Classification Test (/inspect-data/) is hidden from nav until the real UI
  // ships — page still exists (noindex) but is unlinked. Tracked in issue #44.
  { href: "/blog/", label: "Blog" },
  { href: "/contact/", label: "Contact" },
];

// Known top-level routes. Blog posts (news + guides) live at /<slug>/ (legacy
// WordPress permalinks); anything not in this set that arrives as a single path
// segment is treated as a blog post for the purpose of highlighting the Blog nav.
const TOP_LEVEL_PATHS = new Set<string>([
  "/",
  "/sample-data",
  "/http-post",
  "/https-post",
  "/ftp-test",
  "/inspect-data",
  "/blog",
  "/contact",
  "/privacy-policy",
  "/terms-and-conditions",
  "/generate",
  "/regex",
  "/mcp",
]);

function isActive(href: string) {
  const normHref = href.replace(/\/+$/, "") || "/";
  if (normHref === currentPath) return true;
  if (
    normHref === "/blog" &&
    currentPath.startsWith("/") &&
    !TOP_LEVEL_PATHS.has(currentPath)
  ) {
    return true;
  }
  return false;
}

const headerNav: HeaderNavItem[] = nav.map((item) =>
  "children" in item
    ? {
        label: item.label,
        // The dropdown trigger is highlighted when any page inside it is open.
        active: item.children.some((c) => isActive(c.href)),
        children: item.children.map((c) => ({ ...c, active: isActive(c.href) })),
      }
    : { ...item, active: isActive(item.href) },
);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {shouldNoindex ? (
      <>
        <meta name="robots" content="noindex, nofollow, noarchive, nosnippet, noimageindex, notranslate" />
        <meta name="googlebot" content="noindex, nofollow" />
      </>
    ) : (
      <link rel="canonical" href={canonical} />
    )}
    <meta property="og:site_name" content="DLP Test" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {ogType === "article" && publishedTime && (
      <meta property="article:published_time" content={publishedTime.toISOString()} />
    )}
    {ogType === "article" && modifiedTime && (
      <meta property="article:modified_time" content={modifiedTime.toISOString()} />
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="theme-color" content="#f7f9fc" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b1220" media="(prefers-color-scheme: dark)" />
    {siteJsonLd && <script type="application/ld+json" set:html={siteJsonLd} />}
    <link rel="icon" type="image/png" href="/favicon.png" sizes="32x32" />
    <link rel="icon" type="image/png" href="/apple-touch-icon.png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="msapplication-TileImage" content="/apple-touch-icon.png" />
    <script is:inline define:vars={{ themeKey: THEME_STORAGE_KEY }}>
      (function () {
        try {
          var t = localStorage.getItem(themeKey);
          if (t === "light" || t === "dark") document.documentElement.dataset.theme = t;
        } catch (e) {}
      })();
    </script>
    <SiteAnalytics enabled={analyticsEnabled} />
  </head>
  <body>
    {analyticsEnabled && (
      <noscript>
        <iframe
          src={`https://www.googletagmanager.com/ns.html?id=${GTM_CONTAINER_ID}`}
          height="0"
          width="0"
          style="display:none;visibility:hidden"
          title="Google Tag Manager"
        />
      </noscript>
    )}
    {isStaging && (
      <div class="staging-banner">
        STAGING — content is not indexed and may differ from production.
      </div>
    )}
    <SiteHeader nav={headerNav} />
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="site-footer-inner">
        <div class="site-footer-start">
          <div>&copy; {new Date().getFullYear()} DLP Test. Created by Brian Hileman.</div>
          <div class="site-footer-links">
          <a href="/privacy-policy/">Privacy</a>
          {" · "}
          <a href="/terms-and-conditions/">Terms</a>
          {" · "}
          <a href="/security-policy/">Security</a>
          {" · "}
          <a href="/contact/">Contact</a>
          </div>
        </div>
        <div class="site-footer-end">
          <button
            type="button"
            class="feedback-trigger-btn"
            data-feedback-trigger
            aria-haspopup="dialog"
            aria-label="Share feedback — report a bug or suggest a feature"
          >Have an idea? Found a bug?</button>
          <SubscribeModal />
          <ThemeToggle />
        </div>
      </div>
    </footer>
    <FeedbackModal />
  </body>
</html>
