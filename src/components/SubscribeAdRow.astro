---
import CyberhavenAd from "@/components/CyberhavenAd.astro";
import SubscribeSection from "@/components/SubscribeSection.astro";
import type { CyberhavenAdUnit } from "@/lib/cyberhaven-ad";

interface Props {
  adUnit?: CyberhavenAdUnit;
}

const { adUnit = "medium-rectangle" } = Astro.props;
---

<div class="subscribe-ad-row">
  <SubscribeSection />
  <CyberhavenAd unit={adUnit} />
</div>
