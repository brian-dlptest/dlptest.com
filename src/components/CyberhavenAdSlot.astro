---
import CyberhavenAd from "@/components/CyberhavenAd.astro";
import { CYBERHAVEN_PAGE_ADS, type CyberhavenAdPage } from "@/lib/cyberhaven-ad";

interface Props {
  page: CyberhavenAdPage;
}

const { page } = Astro.props;
const units = CYBERHAVEN_PAGE_ADS[page];
const hasSidebar = units.includes("skyscraper");
const inlineUnits = units.filter((u) => u !== "skyscraper");
---
{hasSidebar ? (
  <div class="cyberhaven-ad-layout cyberhaven-ad-layout--sidebar">
    <div class="cyberhaven-ad-main">
      <slot />
    </div>
    {/* Skyscraper sidebar on desktop; a leaderboard replaces it on narrow
        viewports, where a 160x600 unit stretched full-width looks bad. CSS
        toggles which one is visible at the 900px breakpoint. */}
    <CyberhavenAd unit="skyscraper" />
    <CyberhavenAd unit="leaderboard" />
  </div>
) : (
  <slot />
)}

{inlineUnits.map((unit) => (
  <CyberhavenAd unit={unit} priority={unit === "leaderboard"} />
))}
