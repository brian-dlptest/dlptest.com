---
// First-party, cookieless page view counting. Replaces Google Tag Manager /
// Google Analytics, which set cookies (removed 2026-11). One request per page
// load to our own endpoint; nothing is stored in the browser. Server side:
// src/pages/api/page-view.ts and src/lib/page-views.ts.
---
<script>
  if (!location.pathname.startsWith("/admin")) {
    let referrer = "";
    try {
      referrer = document.referrer ? new URL(document.referrer).hostname : "";
    } catch {
      // Unparseable referrer: record it as none.
    }
    fetch("/api/page-view/", {
      method: "POST",
      body: JSON.stringify({ path: location.pathname, referrer }),
      headers: { "Content-Type": "text/plain" },
      keepalive: true,
      credentials: "omit",
    }).catch(() => {});
  }
</script>
