---
const action = "/api/http-post/";
---
<div class="post-test-grid">
  <form
    class="post-test post-test--text"
    method="POST"
    action={action}
    data-post-test="text"
  >
    <div class="field">
      <label for="pt-message">Test message <span class="required">*</span></label>
      <textarea
        id="pt-message"
        name="message"
        required
        placeholder="Paste sample data, an SSN, a credit card number, anything you want your DLP to catch. The server reads the request body and discards it."
      ></textarea>
    </div>
    <div class="field" aria-hidden="true">
      <label class="honeypot">
        If you are human, leave this field blank.
        <input type="text" name="website" tabindex="-1" autocomplete="off" />
      </label>
    </div>
    <button type="submit">Submit</button>
    <p class="result" role="status"></p>
  </form>

  <form
    class="post-test post-test--file"
    method="POST"
    action={action}
    enctype="multipart/form-data"
    data-post-test="file"
  >
    <div class="field">
      <label for="pt-file">File upload <span class="required">*</span></label>
      <div class="file-drop">
        <input id="pt-file" type="file" name="file" required />
        <p class="file-drop__hint">
          Drop a file here or click to upload
        </p>
        <p class="muted small file-drop__limit">
          Maximum file size: 100 MB. Nothing you send is stored or forwarded; the server reads the attachment and discards it.
        </p>
      </div>
    </div>
    <div class="field" aria-hidden="true">
      <label class="honeypot">
        If you are human, leave this field blank.
        <input type="text" name="website" tabindex="-1" autocomplete="off" />
      </label>
    </div>
    <button type="submit">Submit</button>
    <p class="result" role="status"></p>
  </form>
</div>

<style>
  .post-test-grid {
    display: grid;
    gap: 1.25rem;
    margin: 1.25rem 0;
  }

  @media (min-width: 720px) {
    .post-test-grid {
      grid-template-columns: 1fr 1fr;
      align-items: stretch;
    }

    form.post-test {
      display: flex;
      flex-direction: column;
    }

    form.post-test--file .field:has(.file-drop) {
      flex: 1;
      display: flex;
      flex-direction: column;
      min-height: 0;
    }

    form.post-test--file .file-drop {
      flex: 1;
      min-height: 12rem;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }
  }

  form.post-test {
    background: var(--bg-elev);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.25rem;
    margin: 0;
  }

  form.post-test .field {
    margin-bottom: 1rem;
  }

  form.post-test label {
    display: block;
    font-weight: 500;
    margin-bottom: 0.35rem;
  }

  form.post-test .required {
    color: var(--danger);
  }

  form.post-test textarea {
    width: 100%;
    min-height: 12rem;
    resize: vertical;
  }

  form.post-test button[type="submit"] {
    align-self: flex-start;
    width: auto;
    padding: 0.45rem 1.1rem;
    font-size: 0.9rem;
    font-weight: 600;
  }

  form.post-test .honeypot {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  form.post-test .result {
    margin-top: 0.75rem;
    min-height: 1.5rem;
  }

  form.post-test .result.success {
    color: var(--success);
  }

  form.post-test .result.error {
    color: var(--danger);
  }

  .file-drop {
    position: relative;
    border: 2px dashed var(--border);
    border-radius: var(--radius);
    padding: 1.5rem 1rem;
    min-height: 12rem;
    text-align: center;
    background: var(--bg);
    box-sizing: border-box;
  }

  .file-drop input[type="file"] {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    cursor: pointer;
  }

  .file-drop__hint {
    margin: 0 0 0.5rem;
    font-weight: 500;
    pointer-events: none;
  }

  .file-drop__limit {
    margin: 0;
    pointer-events: none;
  }

  .file-drop:has(input:valid:not([value=""])) .file-drop__hint,
  .file-drop.is-selected .file-drop__hint {
    color: var(--accent);
  }
</style>

<script>
  import {
    trackHttpPostAttachmentSubmitClick,
    trackHttpPostTextSubmitClick,
  } from "@/lib/analytics";

  document.querySelectorAll<HTMLFormElement>("form.post-test").forEach((form) => {
    const kind = form.dataset.postTest;
    const fileInput = form.querySelector<HTMLInputElement>('input[type="file"]');
    const fileDrop = form.querySelector<HTMLElement>(".file-drop");

    fileInput?.addEventListener("change", () => {
      if (!fileDrop) return;
      const file = fileInput.files?.[0];
      fileDrop.classList.toggle("is-selected", Boolean(file && file.size > 0));
      if (file && file.size > 0) {
        const hint = fileDrop.querySelector(".file-drop__hint");
        if (hint) hint.textContent = file.name;
      }
    });

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const result = form.querySelector<HTMLElement>(".result");
      if (result) {
        result.textContent = "Submitting…";
        result.className = "result";
      }

      const fd = new FormData(form);
      if (String(fd.get("website") ?? "").trim()) return;

      if (kind === "text") {
        const message = String(fd.get("message") ?? "").trim();
        if (!message) {
          if (result) {
            result.textContent = "Enter a test message before submitting.";
            result.className = "result error";
          }
          return;
        }
        trackHttpPostTextSubmitClick();
        fd.delete("file");
      } else if (kind === "file") {
        const file = fd.get("file");
        const hasFile = file instanceof File && file.size > 0;
        if (!hasFile) {
          if (result) {
            result.textContent = "Choose a file before submitting.";
            result.className = "result error";
          }
          return;
        }
        trackHttpPostAttachmentSubmitClick();
        fd.delete("message");
      }

      try {
        const res = await fetch(form.action, { method: "POST", body: fd });
        if (res.ok) {
          if (result) {
            result.textContent =
              "Received. Nothing was stored. Check your DLP console for an incident.";
            result.className = "result success";
          }
          form.reset();
          fileDrop?.classList.remove("is-selected");
          const hint = fileDrop?.querySelector(".file-drop__hint");
          if (hint) hint.textContent = "Drop a file here or click to upload";
        } else if (result) {
          result.textContent = `Submission failed: ${res.status} ${res.statusText}`;
          result.className = "result error";
        }
      } catch (err) {
        if (result) {
          result.textContent = `Submission failed: ${(err as Error).message}`;
          result.className = "result error";
        }
      }
    });
  });
</script>
