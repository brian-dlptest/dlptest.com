---
const action = "/api/http-post/";
---
<form class="post-test" method="POST" action={action} enctype="multipart/form-data">
  <div class="field">
    <label for="pt-message">Test message</label>
    <textarea id="pt-message" name="message" placeholder="Paste sample data, an SSN, a credit card number, anything you want your DLP to catch."></textarea>
  </div>
  <div class="field">
    <label for="pt-file">File upload</label>
    <input id="pt-file" type="file" name="file" />
    <p class="muted small">Maximum file size: 100 MB. Nothing you send is stored or forwarded; the server reads the request body and discards it.</p>
  </div>
  <div class="field" aria-hidden="true">
    <label class="honeypot">
      If you are human, leave this field blank.
      <input type="text" name="website" tabindex="-1" autocomplete="off" />
    </label>
  </div>
  <button type="submit">Submit</button>
  <p class="result" role="status"></p>
</form>

<style>
  form.post-test {
    background: var(--bg-elev);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.25rem;
    margin: 1.25rem 0;
  }
  form.post-test .field { margin-bottom: 1rem; }
  form.post-test label { display: block; font-weight: 500; margin-bottom: 0.35rem; }
  form.post-test .honeypot { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }
  form.post-test .result { margin-top: 0.75rem; min-height: 1.5rem; }
  form.post-test .result.success { color: var(--success); }
  form.post-test .result.error { color: var(--danger); }
</style>

<script>
  import {
    trackHttpPostAttachmentSubmitClick,
    trackHttpPostTextSubmitClick,
  } from "@/lib/analytics";

  document.querySelectorAll<HTMLFormElement>("form.post-test").forEach((form) => {
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const result = form.querySelector<HTMLElement>(".result");
      if (result) {
        result.textContent = "Submitting…";
        result.className = "result";
      }
      const fd = new FormData(form);
      if (String(fd.get("website") ?? "").trim()) return;

      const message = String(fd.get("message") ?? "").trim();
      const file = fd.get("file");
      const hasFile = file instanceof File && file.size > 0;
      if (message) trackHttpPostTextSubmitClick();
      if (hasFile) trackHttpPostAttachmentSubmitClick();

      try {
        const res = await fetch(form.action, { method: "POST", body: fd });
        if (res.ok) {
          if (result) {
            result.textContent = "Received. Nothing was stored. Check your DLP console for an incident.";
            result.className = "result success";
          }
          form.reset();
        } else {
          if (result) {
            result.textContent = `Submission failed: ${res.status} ${res.statusText}`;
            result.className = "result error";
          }
        }
      } catch (err) {
        if (result) {
          result.textContent = `Submission failed: ${(err as Error).message}`;
          result.className = "result error";
        }
      }
    });
  });
</script>
