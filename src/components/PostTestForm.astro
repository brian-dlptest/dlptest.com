---
const action = "/api/http-post/";
const maxBytes = 100 * 1024 * 1024;
---
<div class="post-test-grid">
  <form
    class="post-test post-test--text"
    method="POST"
    action={action}
    data-post-test="text"
  >
    <div class="field">
      <label for="pt-message">Test message <span class="required">*</span></label>
      <textarea
        id="pt-message"
        name="message"
        required
        placeholder="Paste sample data, an SSN, a credit card number, anything you want your DLP to catch. The server reads the request body and discards it."
      ></textarea>
    </div>
    <div class="field" aria-hidden="true">
      <label class="honeypot">
        If you are human, leave this field blank.
        <input type="text" name="website" tabindex="-1" autocomplete="off" />
      </label>
    </div>
    <button type="submit">Submit</button>
    <p class="result" role="status"></p>
  </form>

  <form
    class="post-test post-test--file"
    method="POST"
    action={action}
    enctype="multipart/form-data"
    data-post-test="file"
    data-max-bytes={maxBytes}
  >
    <div class="field">
      <label for="pt-file">File upload <span class="required">*</span></label>
      <div class="file-drop" data-file-drop>
        <input
          id="pt-file"
          type="file"
          multiple
          aria-describedby="pt-file-hint pt-file-limit"
        />
        <p id="pt-file-hint" class="file-drop__hint">
          Drop files here or click to add
        </p>
        <p id="pt-file-limit" class="muted small file-drop__limit">
          Maximum total upload size: 100 MB. Nothing you send is stored or forwarded; the server reads each attachment and discards it.
        </p>
      </div>
      <ul class="file-queue" data-file-queue hidden></ul>
    </div>
    <div class="field" aria-hidden="true">
      <label class="honeypot">
        If you are human, leave this field blank.
        <input type="text" name="website" tabindex="-1" autocomplete="off" />
      </label>
    </div>
    <button type="submit" data-file-submit disabled>Submit</button>
    <p class="result" role="status"></p>
  </form>
</div>

<style>
  .post-test-grid {
    display: grid;
    gap: 1.25rem;
    margin: 1.25rem 0;
  }

  @media (min-width: 720px) {
    .post-test-grid {
      grid-template-columns: 1fr 1fr;
      align-items: stretch;
    }

    form.post-test {
      display: flex;
      flex-direction: column;
    }

    form.post-test--file .field:has(.file-drop) {
      flex: 1;
      display: flex;
      flex-direction: column;
      min-height: 0;
    }

    form.post-test--file .file-drop {
      flex: 1;
      min-height: 12rem;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }
  }

  form.post-test {
    background: var(--bg-elev);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.25rem;
    margin: 0;
  }

  form.post-test .field {
    margin-bottom: 1rem;
  }

  form.post-test label {
    display: block;
    font-weight: 500;
    margin-bottom: 0.35rem;
  }

  form.post-test .required {
    color: var(--danger);
  }

  form.post-test textarea {
    width: 100%;
    min-height: 12rem;
    resize: vertical;
  }

  form.post-test button[type="submit"] {
    align-self: flex-start;
    width: auto;
    padding: 0.45rem 1.1rem;
    font-size: 0.9rem;
    font-weight: 600;
  }

  form.post-test button[type="submit"]:disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }

  form.post-test .honeypot {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  form.post-test .result {
    margin-top: 0.75rem;
    min-height: 1.5rem;
  }

  form.post-test .result.success {
    color: var(--success);
  }

  form.post-test .result.error {
    color: var(--danger);
  }

  .file-drop {
    position: relative;
    border: 2px dashed var(--border);
    border-radius: var(--radius);
    padding: 1.5rem 1rem;
    min-height: 12rem;
    text-align: center;
    background: var(--bg);
    box-sizing: border-box;
  }

  .file-drop input[type="file"] {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    cursor: pointer;
  }

  .file-drop__hint {
    margin: 0 0 0.5rem;
    font-weight: 500;
    pointer-events: none;
  }

  .file-drop__limit {
    margin: 0;
    pointer-events: none;
  }

  .file-drop.has-files .file-drop__hint {
    color: var(--accent);
  }

  .file-queue {
    list-style: none;
    margin: 0.75rem 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .file-queue[hidden] {
    display: none;
  }

  .file-queue__item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0.5rem 0.45rem 0.65rem;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    font-size: 0.9rem;
  }

  .file-queue__name {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .file-queue__meta {
    flex-shrink: 0;
    color: var(--text-dim);
    font-size: 0.8rem;
  }

  .file-queue__remove {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    padding: 0;
    border: none;
    border-radius: var(--radius);
    background: transparent;
    color: var(--text-dim);
    font-size: 1.25rem;
    line-height: 1;
    cursor: pointer;
  }

  .file-queue__remove:hover {
    background: color-mix(in srgb, var(--danger) 12%, transparent);
    color: var(--danger);
  }
</style>

<script>
  import {
    trackHttpPostAttachmentSubmitClick,
    trackHttpPostTextSubmitClick,
  } from "@/lib/analytics";

  function formatFileSize(bytes: number): string {
    if (bytes < 1024) return `${bytes} B`;
    if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`;
    return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;
  }

  function fileKey(file: File): string {
    return `${file.name}:${file.size}:${file.lastModified}`;
  }

  function initFileForm(form: HTMLFormElement) {
    const maxBytes = Number(form.dataset.maxBytes) || 100 * 1024 * 1024;
    const fileInput = form.querySelector<HTMLInputElement>('input[type="file"]');
    const fileDrop = form.querySelector<HTMLElement>("[data-file-drop]");
    const fileQueue = form.querySelector<HTMLUListElement>("[data-file-queue]");
    const submitBtn = form.querySelector<HTMLButtonElement>("[data-file-submit]");
    const result = form.querySelector<HTMLElement>(".result");
    const pending: File[] = [];

    if (!fileInput || !fileQueue || !submitBtn) return;

    function totalBytes(): number {
      return pending.reduce((sum, f) => sum + f.size, 0);
    }

    function syncUi() {
      const hasFiles = pending.length > 0;
      fileQueue.hidden = !hasFiles;
      submitBtn.disabled = !hasFiles;
      fileDrop?.classList.toggle("has-files", hasFiles);

      fileQueue.innerHTML = "";
      pending.forEach((file, index) => {
        const li = document.createElement("li");
        li.className = "file-queue__item";

        const name = document.createElement("span");
        name.className = "file-queue__name";
        name.textContent = file.name;
        name.title = file.name;

        const meta = document.createElement("span");
        meta.className = "file-queue__meta";
        meta.textContent = formatFileSize(file.size);

        const remove = document.createElement("button");
        remove.type = "button";
        remove.className = "file-queue__remove";
        remove.setAttribute("aria-label", `Remove ${file.name}`);
        remove.textContent = "×";

        remove.addEventListener("click", () => {
          pending.splice(index, 1);
          syncUi();
        });

        li.append(name, meta, remove);
        fileQueue.append(li);
      });
    }

    function addFiles(files: File[]) {
      let rejected = false;
      for (const file of files) {
        if (file.size === 0) continue;
        if (pending.some((f) => fileKey(f) === fileKey(file))) continue;

        if (file.size > maxBytes) {
          if (result) {
            result.textContent = `${file.name} exceeds the 100 MB per-file limit.`;
            result.className = "result error";
          }
          rejected = true;
          continue;
        }
        if (totalBytes() + file.size > maxBytes) {
          if (result) {
            result.textContent =
              "Total upload size cannot exceed 100 MB. Remove a file or submit the current list first.";
            result.className = "result error";
          }
          rejected = true;
          break;
        }

        pending.push(file);
      }

      if (!rejected && result?.classList.contains("error")) {
        result.textContent = "";
        result.className = "result";
      }

      fileInput.value = "";
      syncUi();
    }

    fileInput.addEventListener("change", () => {
      addFiles(Array.from(fileInput.files ?? []));
    });

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (result) {
        result.textContent = "Submitting…";
        result.className = "result";
      }

      const honeypot = form.querySelector<HTMLInputElement>(
        'input[name="website"]',
      );
      if (String(honeypot?.value ?? "").trim()) return;

      if (pending.length === 0) {
        if (result) {
          result.textContent = "Add at least one file before submitting.";
          result.className = "result error";
        }
        return;
      }

      trackHttpPostAttachmentSubmitClick();

      const fd = new FormData();
      if (honeypot) fd.append("website", honeypot.value);
      for (const file of pending) {
        fd.append("file", file, file.name);
      }

      try {
        const res = await fetch(form.action, { method: "POST", body: fd });
        if (res.ok) {
          if (result) {
            result.textContent =
              "Received. Nothing was stored. Check your DLP console for an incident.";
            result.className = "result success";
          }
          pending.length = 0;
          syncUi();
          form.reset();
        } else if (result) {
          result.textContent = `Submission failed: ${res.status} ${res.statusText}`;
          result.className = "result error";
        }
      } catch (err) {
        if (result) {
          result.textContent = `Submission failed: ${(err as Error).message}`;
          result.className = "result error";
        }
      }
    });

    syncUi();
  }

  document.querySelectorAll<HTMLFormElement>("form.post-test").forEach((form) => {
    const kind = form.dataset.postTest;

    if (kind === "file") {
      initFileForm(form);
      return;
    }

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const result = form.querySelector<HTMLElement>(".result");
      if (result) {
        result.textContent = "Submitting…";
        result.className = "result";
      }

      const fd = new FormData(form);
      if (String(fd.get("website") ?? "").trim()) return;

      const message = String(fd.get("message") ?? "").trim();
      if (!message) {
        if (result) {
          result.textContent = "Enter a test message before submitting.";
          result.className = "result error";
        }
        return;
      }
      trackHttpPostTextSubmitClick();

      try {
        const res = await fetch(form.action, { method: "POST", body: fd });
        if (res.ok) {
          if (result) {
            result.textContent =
              "Received. Nothing was stored. Check your DLP console for an incident.";
            result.className = "result success";
          }
          form.reset();
        } else if (result) {
          result.textContent = `Submission failed: ${res.status} ${res.statusText}`;
          result.className = "result error";
        }
      } catch (err) {
        if (result) {
          result.textContent = `Submission failed: ${(err as Error).message}`;
          result.className = "result error";
        }
      }
    });
  });
</script>
