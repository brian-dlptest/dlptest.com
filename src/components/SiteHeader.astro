---
export interface HeaderNavLink {
  href: string;
  label: string;
  active: boolean;
}

export interface HeaderNavItem {
  /** Absent when the item is a dropdown (children present instead). */
  href?: string;
  label: string;
  active: boolean;
  children?: HeaderNavLink[];
}

interface Props {
  nav: HeaderNavItem[];
}

const { nav } = Astro.props;
---
<header class="site-header" data-site-header>
  <div class="site-header-inner">
    <a href="/" class="site-brand">
      <img
        src="/dlp-test-logo.png"
        alt="DLP Test"
        class="site-brand-logo site-brand-logo--dark"
        width="214"
        height="45"
        decoding="async"
      />
      <img
        src="/dlp-test-logo-light.png"
        alt="DLP Test"
        class="site-brand-logo site-brand-logo--light"
        width="214"
        height="45"
        decoding="async"
        aria-hidden="true"
      />
    </a>

    <div class="site-header-toolbar">
      <button
        type="button"
        class="nav-menu-toggle"
        aria-expanded="false"
        aria-controls="primary-navigation"
        aria-label="Open menu"
      >
        <svg class="nav-menu-icon nav-menu-icon--open" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
        <svg class="nav-menu-icon nav-menu-icon--close" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </button>
    </div>

    <nav id="primary-navigation" class="site-nav" aria-label="Primary">
      {nav.map((item) =>
        item.children ? (
          <div class="nav-dropdown" data-nav-dropdown>
            <button
              type="button"
              class="nav-dropdown-trigger"
              aria-expanded="false"
              aria-haspopup="true"
              data-active={item.active ? "true" : undefined}
            >
              {item.label}
              <svg class="nav-dropdown-caret" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <path d="M6 9l6 6 6-6"></path>
              </svg>
            </button>
            <ul class="nav-dropdown-menu">
              {item.children.map((child) => (
                <li>
                  <a href={child.href} aria-current={child.active ? "page" : undefined}>
                    {child.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ) : (
          <a href={item.href} aria-current={item.active ? "page" : undefined}>
            {item.label}
          </a>
        ),
      )}
    </nav>
  </div>
</header>

<script>
  function initSiteHeader() {
    const header = document.querySelector<HTMLElement>("[data-site-header]");
    const toggle = header?.querySelector<HTMLButtonElement>(".nav-menu-toggle");
    const nav = header?.querySelector<HTMLElement>(".site-nav");
    if (!header || !toggle || !nav) return;

    const close = () => {
      header.classList.remove("site-header--nav-open");
      toggle.setAttribute("aria-expanded", "false");
      toggle.setAttribute("aria-label", "Open menu");
    };

    toggle.addEventListener("click", () => {
      const open = !header.classList.contains("site-header--nav-open");
      header.classList.toggle("site-header--nav-open", open);
      toggle.setAttribute("aria-expanded", open ? "true" : "false");
      toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    });

    nav.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", close);
    });

    const dropdowns = Array.from(
      nav.querySelectorAll<HTMLElement>("[data-nav-dropdown]"),
    );

    const closeDropdowns = () => {
      dropdowns.forEach((dd) => {
        dd.classList.remove("nav-dropdown--open");
        dd.querySelector("button")?.setAttribute("aria-expanded", "false");
      });
    };

    dropdowns.forEach((dd) => {
      const trigger = dd.querySelector<HTMLButtonElement>("button");
      trigger?.addEventListener("click", () => {
        const open = !dd.classList.contains("nav-dropdown--open");
        closeDropdowns();
        dd.classList.toggle("nav-dropdown--open", open);
        trigger.setAttribute("aria-expanded", open ? "true" : "false");
      });
    });

    document.addEventListener("click", (event) => {
      if (!dropdowns.some((dd) => dd.contains(event.target as Node))) {
        closeDropdowns();
      }
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        close();
        closeDropdowns();
      }
    });
  }

  initSiteHeader();
  document.addEventListener("astro:page-load", initSiteHeader);
</script>
