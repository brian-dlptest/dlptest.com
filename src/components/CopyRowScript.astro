<script>
  document.querySelectorAll<HTMLElement>("[data-copy-table] table").forEach((table) => {
    const theadRow = table.querySelector("thead tr");
    if (theadRow) {
      const th = document.createElement("th");
      th.className = "copy-col";

      const allBtn = document.createElement("button");
      allBtn.className = "copy-btn";
      allBtn.textContent = "Copy all";
      allBtn.addEventListener("click", async () => {
        const rows = [...table.querySelectorAll<HTMLElement>("tbody tr")];
        const text = rows
          .map((tr) =>
            [...tr.querySelectorAll<HTMLElement>("td:not(.copy-col)")]
              .map((c) => c.textContent?.trim() ?? "")
              .join("\t")
          )
          .join("\n");
        try {
          await navigator.clipboard.writeText(text);
          allBtn.textContent = "Copied!";
          allBtn.classList.add("copied");
          setTimeout(() => {
            allBtn.textContent = "Copy all";
            allBtn.classList.remove("copied");
          }, 1500);
        } catch {
          allBtn.textContent = "Error";
          setTimeout(() => { allBtn.textContent = "Copy all"; }, 1500);
        }
      });

      th.appendChild(allBtn);
      theadRow.appendChild(th);
    }


  });
</script>

<style is:global>
  .copy-col {
    width: 1%;
    white-space: nowrap;
    text-align: center;
    padding-left: 0.5rem !important;
    padding-right: 0.5rem !important;
  }

  .copy-btn {
    font-size: 0.72rem;
    padding: 0.18rem 0.5rem;
    background: var(--bg-elev);
    color: var(--text-dim);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    cursor: pointer;
    transition: color 0.15s, border-color 0.15s;
    line-height: 1.4;
  }

  .copy-btn:hover {
    color: var(--text);
    border-color: color-mix(in srgb, var(--border) 50%, var(--accent));
  }

  .copy-btn.copied {
    color: var(--accent);
    border-color: var(--accent);
  }
</style>
