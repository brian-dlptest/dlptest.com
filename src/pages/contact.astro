---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { env } from "cloudflare:workers";
export const prerender = true;

// Cloudflare Turnstile site key — public, baked into the prerendered page at
// build time. Falls back to Cloudflare's always-pass test key when unset (local
// dev). Mirrors src/components/FeedbackModal.astro.
const siteKey = env.CF_TURNSTILE_SITE_KEY?.trim() || "1x00000000000000000000AA";
---
<BaseLayout title="Contact" description="Get in touch with DLP Test.">
  <h1>Contact</h1>
  <p>
    Drop a note about the site, a feature request, or to ask about an IP
    that’s been blocked from the FTP server.
  </p>

  <div class="contact-grid">
    <form id="contact-form" method="POST" action="/api/contact/">
      <div class="field">
        <label for="c-name">Name</label>
        <input id="c-name" name="name" type="text" autocomplete="name" required />
      </div>
      <div class="field">
        <label for="c-email">Email</label>
        <input id="c-email" name="email" type="email" autocomplete="email" required />
      </div>
      <div class="field">
        <label for="c-company">Company <span class="optional">(optional)</span></label>
        <input id="c-company" name="company" type="text" autocomplete="organization" />
      </div>
      <div class="field">
        <label for="c-subject">Subject</label>
        <input id="c-subject" name="subject" type="text" required />
      </div>
      <div class="field">
        <label for="c-message">Message</label>
        <textarea id="c-message" name="message" required></textarea>
      </div>
      <div class="field field--checkbox">
        <label class="checkbox-label" for="c-subscribe">
          <input
            id="c-subscribe"
            name="subscribe_updates"
            type="checkbox"
            value="1"
            checked
          />
          <span class="checkbox-copy">
            <span class="checkbox-title">Subscribe to Updates</span>
            <span class="checkbox-desc muted small">
              Get notified about new test tools, sample data, and data security news.
            </span>
          </span>
        </label>
      </div>
      <div class="field honeypot" aria-hidden="true">
        <label>If you are human, leave this field blank.
          <input type="text" name="website" tabindex="-1" autocomplete="off" />
        </label>
      </div>
      <!-- Cloudflare Turnstile widget (rendered explicitly via JS) -->
      <div id="c-turnstile" class="contact-turnstile"></div>
      <button type="submit">Send</button>
      <p class="result" role="status"></p>
    </form>

    <aside class="author-card">
      <h2>About the creator</h2>
      <p>
        Brian Hileman has over a decade of experience in data protection,
        specializing in Data Loss Prevention (DLP) and Insider Risk Management.
        He created and maintains DLPTest.com, a resource for evaluating and
        testing DLP capabilities.
      </p>
      <p>
        Brian is currently Solution Architect at Cyberhaven. He has held roles
        at Palo Alto Networks, Digital Guardian, and InteliSecure (acquired by
        Proofpoint), with hands-on experience across DLP, CASB, and broader data
        security strategy.
      </p>
      <p>
        He speaks regularly at industry conferences, including ISSA, CSA, and
        RMISC, where he shares practical guidance on protecting sensitive data.
      </p>
      <p class="author-card__links">
        <a
          class="linkedin-link"
          href="https://www.linkedin.com/in/brianhileman/"
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg
            class="linkedin-link__icon"
            aria-hidden="true"
            viewBox="0 0 24 24"
            width="18"
            height="18"
            fill="currentColor"
          >
            <path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.86-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.36V9h3.41v1.56h.05c.47-.9 1.63-1.86 3.36-1.86 3.6 0 4.27 2.37 4.27 5.45v6.3zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.55C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0z"/>
          </svg>
          <span>Connect on LinkedIn</span>
        </a>
      </p>
    </aside>
  </div>

  <section class="feedback-callout">
    <div class="feedback-callout__copy">
      <h2>Found a bug or have an idea?</h2>
      <p>
        Spotted something broken or have a feature request for the site? File it
        straight to our issue tracker on GitHub — no account form required.
      </p>
    </div>
    <button
      type="button"
      class="feedback-callout__btn"
      data-feedback-trigger
      aria-haspopup="dialog"
      aria-label="Share feedback — report a bug or suggest a feature"
    >
      🐛 Report a bug / 💡 Suggest an idea
    </button>
  </section>

  <style>
    .contact-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 2rem;
      align-items: start;
      margin-top: 1.5rem;
    }

    @media (min-width: 900px) {
      .contact-grid {
        grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
        gap: 2.5rem;
      }
    }

    #contact-form { background: var(--bg-elev); border: 1px solid var(--border); border-radius: var(--radius); padding: 1.25rem; margin: 0; }
    #contact-form .field { margin-bottom: 1rem; }
    #contact-form label { display: block; font-weight: 500; margin-bottom: 0.35rem; }
    #contact-form .optional { color: var(--text-dim); font-weight: 400; }
    #contact-form .field--checkbox { margin-bottom: 1.25rem; }
    #contact-form .checkbox-label {
      display: flex;
      gap: 0.65rem;
      align-items: flex-start;
      font-weight: 400;
      margin-bottom: 0;
      cursor: pointer;
    }
    #contact-form .checkbox-label input {
      margin-top: 0.2rem;
      flex-shrink: 0;
    }
    #contact-form .checkbox-copy {
      display: flex;
      flex-direction: column;
      gap: 0.2rem;
    }
    #contact-form .checkbox-title { font-weight: 600; color: var(--text); }
    #contact-form .honeypot { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }
    #contact-form .contact-turnstile { margin-bottom: 1rem; min-height: 65px; }
    #contact-form .result { margin-top: 0.75rem; min-height: 1.5rem; }
    #contact-form .result.success { color: var(--success); }
    #contact-form .result.error { color: var(--danger); }

    .author-card {
      background: var(--bg-elev);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 1.25rem 1.5rem;
      box-shadow: var(--shadow-sm);
    }
    .author-card h2 {
      margin-top: 0;
      margin-bottom: 0.75rem;
      font-size: 1.25rem;
    }
    .author-card p {
      color: var(--text-dim);
      line-height: 1.65;
    }
    .author-card p:last-of-type { margin-bottom: 0; }
    .author-card__links {
      margin-top: 1.25rem;
      margin-bottom: 0;
    }
    .linkedin-link {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.55rem 0.9rem;
      border: 1px solid color-mix(in srgb, var(--accent) 30%, var(--border));
      border-radius: 999px;
      color: var(--accent);
      font-weight: 600;
      font-size: 0.95rem;
      text-decoration: none;
      transition: background var(--transition-fast), border-color var(--transition-fast), color var(--transition-fast);
    }
    .linkedin-link:hover {
      background: color-mix(in srgb, var(--accent) 10%, transparent);
      border-color: var(--accent);
      color: var(--accent);
    }
    .linkedin-link__icon {
      flex-shrink: 0;
    }

    .feedback-callout {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 1.25rem;
      margin-top: 2rem;
      padding: 1.25rem 1.5rem;
      background: var(--bg-elev);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      box-shadow: var(--shadow-sm);
    }
    .feedback-callout__copy { flex: 1 1 18rem; }
    .feedback-callout h2 {
      margin: 0 0 0.4rem;
      font-size: 1.15rem;
    }
    .feedback-callout p {
      margin: 0;
      color: var(--text-dim);
      line-height: 1.6;
    }
    .feedback-callout__btn {
      flex-shrink: 0;
      white-space: nowrap;
    }
  </style>

  <script define:vars={{ siteKey }}>
    let widgetId = null;
    let turnstileToken = null;

    function initContactForm() {
      const form = document.getElementById("contact-form");
      const turnstileContainer = document.getElementById("c-turnstile");
      if (!form || !turnstileContainer) return;
      // Guard against binding the submit handler twice on the same DOM instance
      // (initContactForm runs both directly and on astro:page-load) — a double
      // bind would POST the contact form twice.
      if (form.dataset.contactInit === "1") return;
      form.dataset.contactInit = "1";

      // Reset state on each page-load (Astro view transitions respawn the DOM).
      widgetId = null;
      turnstileToken = null;
      loadTurnstile();

      function loadTurnstile() {
        if (window.turnstile) {
          renderWidget();
          return;
        }
        if (document.getElementById("turnstile-script")) return;
        const script = document.createElement("script");
        script.id = "turnstile-script";
        script.src = "https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit";
        script.async = true;
        script.onload = renderWidget;
        document.head.appendChild(script);
      }

      function renderWidget() {
        if (!window.turnstile || !turnstileContainer) return;
        if (widgetId !== null) {
          window.turnstile.reset(widgetId);
          return;
        }
        turnstileContainer.innerHTML = "";
        widgetId = window.turnstile.render(turnstileContainer, {
          sitekey: siteKey,
          callback: (token) => { turnstileToken = token; },
          "expired-callback": () => { turnstileToken = null; },
          "error-callback": () => { turnstileToken = null; },
        });
      }

      function resetTurnstile() {
        turnstileToken = null;
        if (widgetId !== null && window.turnstile) {
          window.turnstile.reset(widgetId);
        }
      }

      form.addEventListener("submit", async (event) => {
        event.preventDefault();
        const result = form.querySelector(".result");
        const setResult = (msg, cls) => {
          if (result) {
            result.textContent = msg;
            result.className = "result" + (cls ? " " + cls : "");
          }
        };

        if (!turnstileToken) {
          setResult("Please complete the security check.", "error");
          return;
        }

        setResult("Sending…", "");
        const fd = new FormData(form);
        fd.set("turnstileToken", turnstileToken);
        try {
          const res = await fetch(form.action, { method: "POST", body: fd });
          if (res.ok) {
            setResult("Thanks — message received.", "success");
            form.reset();
            resetTurnstile();
          } else {
            const data = await res.json().catch(() => ({}));
            const msg =
              data.error === "captcha_failed"
                ? "Security check failed. Please try again."
                : data.message ||
                  `Something went wrong (${res.status}). Please try again.`;
            setResult(msg, "error");
            resetTurnstile();
          }
        } catch (err) {
          setResult(`Network error: ${err.message}`, "error");
        }
      });
    }

    initContactForm();
    document.addEventListener("astro:page-load", initContactForm);
  </script>
</BaseLayout>
