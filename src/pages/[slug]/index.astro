---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";
import type { GetStaticPaths } from "astro";

// Prerender each news post and guide at its root-level permalink — e.g.
// /cyberhaven-raises-100-million-series-d-at-1-billion-valuation/ or
// /what-is-data-loss-prevention-dlp/. The trailing slash matches
// astro.config.mjs (`trailingSlash: "always"`).
export const prerender = true;

export const getStaticPaths = (async () => {
  const posts = await getCollection("news");
  const guides = await getCollection("guides");

  const newsPages = posts.map((post) => ({
    params: { slug: post.data.slug },
    props: { entry: post, type: "news" as const },
  }));

  const guidePages = guides.map((guide) => ({
    params: { slug: guide.data.slug },
    props: { entry: guide, type: "guide" as const },
  }));

  return [...newsPages, ...guidePages];
}) satisfies GetStaticPaths;

const { entry, type } = Astro.props;
const { Content } = await render(entry);

function fmt(d: Date) {
  return d.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
}

// Article structured data. Guides carry an optional updatedDate; news posts
// only have pubDate. The publisher/@id resolves against the Organization
// emitted by BaseLayout on the homepage.
const pageUrl = `https://dlptest.com/${entry.data.slug}/`;
const updated = type === "guide" ? entry.data.updatedDate : undefined;
const articleJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Article",
  headline: entry.data.title,
  datePublished: entry.data.pubDate.toISOString(),
  dateModified: (updated ?? entry.data.pubDate).toISOString(),
  mainEntityOfPage: pageUrl,
  url: pageUrl,
  author: { "@type": "Organization", name: "DLP Test", url: "https://dlptest.com/" },
  publisher: { "@id": "https://dlptest.com/#organization" },
  ...(type === "news" && entry.data.heroImage ? { image: entry.data.heroImage } : {}),
});
---
{type === "guide" ? (
  <BaseLayout
    title={entry.data.title}
    description={entry.data.description}
    ogType="article"
    publishedTime={entry.data.pubDate}
    modifiedTime={entry.data.updatedDate}
  >
    <script type="application/ld+json" set:html={articleJsonLd} />
    <article class="guide-post">
      <p class="news-back">
        <a href="/blog/">← All posts</a>
      </p>
      <header>
        <div class="news-eyebrow">
          <time datetime={entry.data.pubDate.toISOString()}>{fmt(entry.data.pubDate)}</time>
          {entry.data.categories.length > 0 && (
            <span class="news-cats">
              {entry.data.categories.map((c: string) => (
                <span class="news-cat">{c}</span>
              ))}
            </span>
          )}
        </div>
        <h1>{entry.data.title}</h1>
      </header>
      <div class="guide-body">
        <Content />
      </div>
    </article>
  </BaseLayout>
) : (
  <BaseLayout
    title={entry.data.title}
    description={entry.data.excerpt || undefined}
    ogType="article"
    publishedTime={entry.data.pubDate}
  >
    <script type="application/ld+json" set:html={articleJsonLd} />
    <article class="news-post">
      <p class="news-back">
        <a href="/blog/">← All posts</a>
      </p>
      <header>
        <div class="news-eyebrow">
          <time datetime={entry.data.pubDate.toISOString()}>{fmt(entry.data.pubDate)}</time>
          {entry.data.categories.length > 0 && (
            <span class="news-cats">
              {entry.data.categories.map((c: string) => (
                <span class="news-cat">{c}</span>
              ))}
            </span>
          )}
        </div>
        <h1>{entry.data.title}</h1>
      </header>

      {entry.data.heroImage && (
        <figure class="news-hero">
          <img src={entry.data.heroImage} alt="" loading="lazy" />
        </figure>
      )}

      <div class="news-body">
        <Content />
      </div>
    </article>
  </BaseLayout>
)}
