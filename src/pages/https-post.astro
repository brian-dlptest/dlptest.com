---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PostTestForm from "@/components/PostTestForm.astro";
export const prerender = true;
---
<BaseLayout title="HTTPS Post Test" description="Submit text and files over HTTPS to a safe endpoint that immediately discards them. Use it to verify your DLP can block sensitive data over TLS (typically via SSL inspection / ICAP / SSE).">
  <h1>HTTPS Post Test</h1>
  <p>
    Same form as <a href="/http-post/">HTTP Post</a> but over TLS. Use this to
    verify that your DLP can see encrypted traffic — typically via SSL
    inspection on a proxy, an ICAP integration, or an SSE/SASE agent.
  </p>

  <PostTestForm scheme="https" />

  <p class="muted">
    The server accepts the request and discards the body. No data is logged,
    stored, or forwarded.
  </p>
</BaseLayout>
