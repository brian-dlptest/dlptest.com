---
import BaseLayout from "@/layouts/BaseLayout.astro";
import CyberhavenAd from "@/components/CyberhavenAd.astro";
export const prerender = true;

const claudeCodeCliExample = `# Add via the Claude Code CLI (one-time setup)
claude mcp add dlptest --transport http https://mcp.dlptest.com/api/mcp/`;

const claudeCodeJsonExample = `// .claude/settings.json (project) or ~/.claude.json (global)
{
  "mcpServers": {
    "dlptest": {
      "type": "http",
      "url": "https://mcp.dlptest.com/api/mcp/"
    }
  }
}`;

const claudeDesktopConfig = `// claude_desktop_config.json
// macOS: ~/Library/Application Support/Claude/
// Windows: %APPDATA%\\Claude\\
{
  "mcpServers": {
    "dlptest": {
      "type": "http",
      "url": "https://mcp.dlptest.com/api/mcp/"
    }
  }
}`;

const cursorConfig = `// .cursor/mcp.json (project) or ~/.cursor/mcp.json (global)
{
  "mcpServers": {
    "dlptest": {
      "url": "https://mcp.dlptest.com/api/mcp/"
    }
  }
}`;

const windsurfConfig = `// ~/.codeium/windsurf/mcp_config.json
{
  "mcpServers": {
    "dlptest": {
      "serverUrl": "https://mcp.dlptest.com/api/mcp/"
    }
  }
}`;

const vsCodeConfig = `// .vscode/mcp.json (project root)
{
  "servers": {
    "dlptest": {
      "type": "http",
      "url": "https://mcp.dlptest.com/api/mcp/"
    }
  }
}`;

const genericConfig = `{
  "mcpServers": {
    "dlptest": {
      "url": "https://mcp.dlptest.com/api/mcp/"
    }
  }
}`;

const initExample = `# 1. initialize — protocol handshake
curl -sS -X POST "https://mcp.dlptest.com/api/mcp/" \\
  -H "Content-Type: application/json" \\
  -d '{
    "jsonrpc": "2.0",
    "id": 1,
    "method": "initialize",
    "params": {
      "protocolVersion": "2025-06-18",
      "capabilities": {},
      "clientInfo": { "name": "curl", "version": "0.0.1" }
    }
  }'`;

const listExample = `# 2. tools/list — discover available tools
curl -sS -X POST "https://mcp.dlptest.com/api/mcp/" \\
  -H "Content-Type: application/json" \\
  -d '{"jsonrpc":"2.0","id":2,"method":"tools/list"}'`;

const callExample = `# 3. tools/call — invoke a tool (response-side DLP test)
curl -sS -X POST "https://mcp.dlptest.com/api/mcp/" \\
  -H "Content-Type: application/json" \\
  -d '{
    "jsonrpc": "2.0",
    "id": 3,
    "method": "tools/call",
    "params": {
      "name": "generate_pii_ssn_ccn",
      "arguments": { "count": 5, "format": "csv" }
    }
  }'`;

const echoExample = `# echo_sensitive_data — PII travels in the *request* arguments
curl -sS -X POST "https://mcp.dlptest.com/api/mcp/" \\
  -H "Content-Type: application/json" \\
  -d '{
    "jsonrpc": "2.0",
    "id": 4,
    "method": "tools/call",
    "params": {
      "name": "echo_sensitive_data",
      "arguments": {
        "label": "test-run-1",
        "payload": "Patient: Jane Smith  SSN: 123-45-6789  CCN: 4111111111111111"
      }
    }
  }'`;

const promptContextExample = `# generate_prompt_context — simulate RAG / system-prompt PII
curl -sS -X POST "https://mcp.dlptest.com/api/mcp/" \\
  -H "Content-Type: application/json" \\
  -d '{
    "jsonrpc": "2.0",
    "id": 5,
    "method": "tools/call",
    "params": {
      "name": "generate_prompt_context",
      "arguments": { "scenario": "medical-record", "count": 3, "format": "text" }
    }
  }'`;

const probeExample = `# probe_request — verify DLP is on the right network leg
curl -sS -X POST "https://mcp.dlptest.com/api/mcp/" \\
  -H "Content-Type: application/json" \\
  -d '{"jsonrpc":"2.0","id":6,"method":"tools/call","params":{"name":"probe_request","arguments":{}}}'`;

const listPatternsExample = `# list_dlp_patterns — browse the curated DLP regex library
curl -sS -X POST "https://mcp.dlptest.com/api/mcp/" \\
  -H "Content-Type: application/json" \\
  -d '{
    "jsonrpc": "2.0",
    "id": 7,
    "method": "tools/call",
    "params": {
      "name": "list_dlp_patterns",
      "arguments": { "category": "Financial / PCI", "format": "csv" }
    }
  }'`;

const regexTestExample = `# regex_test — match a pattern against text (RE2 engine by default)
curl -sS -X POST "https://mcp.dlptest.com/api/mcp/" \\
  -H "Content-Type: application/json" \\
  -d '{
    "jsonrpc": "2.0",
    "id": 8,
    "method": "tools/call",
    "params": {
      "name": "regex_test",
      "arguments": {
        "pattern": "\\\\b\\\\d{3}-\\\\d{2}-\\\\d{4}\\\\b",
        "flags": "g",
        "text": "SSN: 123-45-6789",
        "engine": "re2"
      }
    }
  }'`;

const localConfig = `// Local instance (npm run dev → http://localhost:4321)
{
  "mcpServers": {
    "dlptest-local": {
      "type": "http",
      "url": "http://localhost:4321/api/mcp/"
    }
  }
}`;
---
<BaseLayout
  title="MCP Server Test"
  description="A public MCP (Model Context Protocol) server that returns synthetic PII, PCI, and PHI data. Use it to test whether your DLP, CASB, or endpoint agent can inspect agentic tool traffic — including prompt-side data and unapproved external MCP connections."
>
  <h1>MCP Server Test</h1>
  <p>
    <strong><code>https://mcp.dlptest.com/api/mcp/</code></strong> is a public
    <a href="https://modelcontextprotocol.io/" target="_blank" rel="noopener noreferrer">Model Context Protocol</a>
    server that exposes the same synthetic PII, PCI, and PHI generators that power this site —
    but over the MCP wire protocol instead of a web page. Point any MCP-capable agent at it
    and the tool calls will flow over real HTTP that your DLP can inspect.
  </p>
  <p class="muted small">
    Data is entirely synthetic. Nothing sent to this endpoint is stored, logged, or forwarded.
    The endpoint is also reachable at <code>https://dlptest.com/api/mcp/</code> as a fallback.
  </p>

  <CyberhavenAd unit="leaderboard" />

  <!-- ── SETUP ─────────────────────────────────────────────── -->
  <h2>Setup</h2>

  <div class="setup-grid">

    <div class="setup-card setup-card--difm">
      <div class="setup-card-header">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
        <h3>Do It For Me</h3>
      </div>
      <p>
        Download the setup file and drop it anywhere in your repository.
        When you ask your AI coding agent to set up the DLPTest MCP server, it
        will use this file to configure the connection.
      </p>
      <a href="/mcp-setup-readme.md" download class="download-btn">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
        Download mcp-setup-readme.md
      </a>
    </div>

    <div class="setup-card setup-card--diy">
      <div class="setup-card-header">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
        <h3>Do It Yourself</h3>
      </div>
      <p>Pick your tool and follow the steps to connect manually.</p>

      <details class="accordion">
        <summary>Claude Code <span class="badge">CLI</span></summary>
        <div class="accordion-body">
          <p class="step">Step 1 — Run the CLI command (adds to your user config):</p>
          <pre><code>{claudeCodeCliExample}</code></pre>
          <p class="step">Step 2 — Or add JSON directly to <code>.claude/settings.json</code> (project) or <code>~/.claude.json</code> (global):</p>
          <pre><code>{claudeCodeJsonExample}</code></pre>
          <p class="step">Step 3 — Verify: ask your agent <em>"List the tools on the dlptest MCP server."</em></p>
        </div>
      </details>

      <details class="accordion">
        <summary>Claude Desktop / Anthropic Agent</summary>
        <div class="accordion-body">
          <p class="step">Step 1 — Open <code>claude_desktop_config.json</code>:</p>
          <ul>
            <li>macOS: <code>~/Library/Application Support/Claude/</code></li>
            <li>Windows: <code>%APPDATA%\Claude\</code></li>
          </ul>
          <p class="step">Step 2 — Add the server entry:</p>
          <pre><code>{claudeDesktopConfig}</code></pre>
          <p class="step">Step 3 — Restart Claude Desktop and verify the dlptest tools appear.</p>
        </div>
      </details>

      <details class="accordion">
        <summary>Cursor</summary>
        <div class="accordion-body">
          <p class="step">Step 1 — Create or edit <code>.cursor/mcp.json</code> in your project root (or <code>~/.cursor/mcp.json</code> for global access):</p>
          <pre><code>{cursorConfig}</code></pre>
          <p class="step">Step 2 — Reload Cursor. The dlptest tools should appear in the MCP panel.</p>
        </div>
      </details>

      <details class="accordion">
        <summary>Windsurf</summary>
        <div class="accordion-body">
          <p class="step">Step 1 — Edit <code>~/.codeium/windsurf/mcp_config.json</code>. Windsurf uses SSE transport, so the URL ends in <code>/sse</code>:</p>
          <pre><code>{windsurfConfig}</code></pre>
          <p class="step">Step 2 — Reload Windsurf and confirm the server is listed under MCP Servers.</p>
        </div>
      </details>

      <details class="accordion">
        <summary>VS Code <span class="badge">GitHub Copilot</span></summary>
        <div class="accordion-body">
          <p class="step">Step 1 — Create <code>.vscode/mcp.json</code> in your project root:</p>
          <pre><code>{vsCodeConfig}</code></pre>
          <p class="step">Step 2 — Open the Copilot chat panel. The dlptest tools should appear in the tool list.</p>
        </div>
      </details>

      <details class="accordion">
        <summary>Other MCP Clients</summary>
        <div class="accordion-body">
          <p>Use the standard <code>mcpServers</code> config format your client expects:</p>
          <pre><code>{genericConfig}</code></pre>
        </div>
      </details>
    </div>

  </div>

  <!-- ── HOW TO USE ─────────────────────────────────────────── -->
  <h2>How to Use</h2>

  <details class="accordion" open>
    <summary>Try it with curl</summary>
    <div class="accordion-body">
      <p>These three requests cover the full MCP handshake — from protocol init through a tool call.</p>
      <pre><code>{initExample}</code></pre>
      <pre><code>{listExample}</code></pre>
      <pre><code>{callExample}</code></pre>
    </div>
  </details>

  <details class="accordion">
    <summary>Test prompt-side DLP</summary>
    <div class="accordion-body">
      <p>
        Most DLP products only inspect the <em>response</em> body. But in a real agent pipeline,
        sensitive content can also flow <em>outward</em> in the tool-call arguments — for example,
        a user pastes a document containing real SSNs and that text gets forwarded as a tool argument.
      </p>
      <h4><code>echo_sensitive_data</code> — outbound argument inspection</h4>
      <p>
        Accepts any text as a <code>payload</code> argument and echoes it back unchanged.
        PII travels in the <em>outbound</em> request — a DLP product that only inspects responses will miss it.
      </p>
      <pre><code>{echoExample}</code></pre>
      <h4><code>generate_prompt_context</code> — RAG / system-prompt simulation</h4>
      <p>
        Returns prose paragraphs with PII embedded inline, mimicking how sensitive data arrives via
        RAG retrieval or an injected system prompt. Scenarios: <code>medical-record</code>,
        <code>financial-statement</code>, <code>hr-file</code>, <code>customer-list</code>.
      </p>
      <pre><code>{promptContextExample}</code></pre>
      <h4><code>probe_request</code> — verify interception point</h4>
      <p>
        Returns the User-Agent, client IP, and timestamp seen by the server.
        Use it to confirm your proxy or endpoint agent is on the expected network leg.
      </p>
      <pre><code>{probeExample}</code></pre>
    </div>
  </details>

  <details class="accordion">
    <summary>Test a regex &amp; browse the DLP pattern library</summary>
    <div class="accordion-body">
      <p>
        <code>regex_test</code> matches a pattern against text and returns every match with its
        capture groups and offsets. It mirrors the interactive
        <a href="/regex/">Regex Test</a> page. Pick the <code>engine</code>: <code>re2</code>
        (default — linear-time and ReDoS-safe) or <code>ecmascript</code>.
      </p>
      <pre><code>{regexTestExample}</code></pre>
      <p>
        <code>list_dlp_patterns</code> returns a curated library of DLP-relevant regular
        expressions — SSN, credit card, IBAN, MRN, API keys, network identifiers, and
        international government IDs — each with a sample string it matches. The same library
        powers the <a href="/regex/">Regex Test</a> page. Filter by <code>category</code> or a
        free-text <code>search</code>; choose <code>json</code> or <code>csv</code> output.
      </p>
      <pre><code>{listPatternsExample}</code></pre>
    </div>
  </details>

  <details class="accordion">
    <summary>Test with a local instance</summary>
    <div class="accordion-body">
      <p>
        To test <em>internal</em> traffic inspection separately from internet egress,
        clone this repo and run <code>npm run dev</code>. The MCP endpoint is available
        at <code>http://localhost:4321/api/mcp/</code>.
      </p>
      <pre><code>{localConfig}</code></pre>
    </div>
  </details>

  <details class="accordion">
    <summary>What to look for in your DLP console</summary>
    <div class="accordion-body">
      <p>After running a few tool calls, check whether your product:</p>
      <ul>
        <li>Caught synthetic SSNs, CCNs, or IBANs in the <strong>response</strong> body.</li>
        <li>Caught PII in the <strong>request</strong> body (tool-call arguments) — use <code>echo_sensitive_data</code> to test this specifically.</li>
        <li>Saw PII arriving as prose context, not tabular data — use <code>generate_prompt_context</code>.</li>
        <li>Logged a connection to <code>mcp.dlptest.com</code> as an outbound MCP server contact.</li>
        <li>Surfaced the <code>tools/list</code> handshake — a keyword-rich signal for pattern scanners.</li>
        <li>Flagged the initial connection to an unapproved external MCP endpoint (CASB / network policy).</li>
      </ul>
    </div>
  </details>

  <!-- ── TOOLS AVAILABLE ───────────────────────────────────── -->
  <h2>Tools Available</h2>
  <p class="muted small">
    Data-generation tools accept <code>count</code> (1–500, default 50) and
    <code>format</code> (<code>"json"</code> or <code>"csv"</code>, default <code>"json"</code>).
  </p>

  <details class="accordion" open>
    <summary>Synthetic data generation</summary>
    <div class="accordion-body">
      <table>
        <thead>
          <tr><th>Tool</th><th>Data returned</th></tr>
        </thead>
        <tbody>
          <tr><td><code>generate_pii_ssn_ccn</code></td><td>Name + SSN + credit card</td></tr>
          <tr><td><code>generate_pii_ssn_dob</code></td><td>Name + SSN + date of birth</td></tr>
          <tr><td><code>generate_pci_credit_card</code></td><td>Name + ZIP + CCN + expiry</td></tr>
          <tr><td><code>generate_pii_email</code></td><td>Name + DOB + email</td></tr>
          <tr><td><code>generate_hipaa_phi</code></td><td>Name + DOB + MRN + ICD-10 + CPT + phone</td></tr>
          <tr><td><code>generate_banking</code></td><td>Name + routing + account + phone</td></tr>
          <tr><td><code>generate_uk_identity</code></td><td>Name + UK NI + NHS + DOB</td></tr>
          <tr><td><code>generate_canada_sin</code></td><td>Name + Canadian SIN + province + DOB</td></tr>
          <tr><td><code>generate_passport</code></td><td>Name + passport + country + DOB + expiry</td></tr>
          <tr><td><code>generate_eu_vat</code></td><td>Name + EU VAT + IBAN + country</td></tr>
          <tr><td><code>generate_npi_provider</code></td><td>Name + NPI + DEA + specialty</td></tr>
          <tr><td><code>generate_driver_license</code></td><td>Name + DL + state + DOB</td></tr>
          <tr>
            <td><code>generate_custom</code></td>
            <td>
              Arbitrary fields. Takes a <code>fields</code> array of
              <code>{`{ name, type, blankPct?, delimiter?, cardBrands? }`}</code> —
              same types as the <a href="/generate/">/generate/</a> page.
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </details>

  <details class="accordion">
    <summary>Prompt-side &amp; diagnostic tools</summary>
    <div class="accordion-body">
      <table>
        <thead>
          <tr><th>Tool</th><th>Description</th></tr>
        </thead>
        <tbody>
          <tr>
            <td><code>echo_sensitive_data</code></td>
            <td>Echoes a <code>payload</code> string back unchanged. PII travels in the outbound request arguments.</td>
          </tr>
          <tr>
            <td><code>generate_prompt_context</code></td>
            <td>Returns prose paragraphs with inline PII simulating RAG retrieval or system-prompt injection. Scenarios: <code>medical-record</code>, <code>financial-statement</code>, <code>hr-file</code>, <code>customer-list</code>.</td>
          </tr>
          <tr>
            <td><code>probe_request</code></td>
            <td>Returns User-Agent, client IP, and timestamp to confirm the interception point.</td>
          </tr>
        </tbody>
      </table>
    </div>
  </details>

  <details class="accordion">
    <summary>Regex &amp; DLP pattern library</summary>
    <div class="accordion-body">
      <table>
        <thead>
          <tr><th>Tool</th><th>Description</th></tr>
        </thead>
        <tbody>
          <tr>
            <td><code>regex_test</code></td>
            <td>
              Matches a <code>pattern</code> against <code>text</code> and returns matches with
              capture groups and offsets. <code>engine</code>: <code>re2</code> (default,
              linear-time) or <code>ecmascript</code>; JS-style <code>flags</code>.
            </td>
          </tr>
          <tr>
            <td><code>list_dlp_patterns</code></td>
            <td>
              Returns the curated DLP regex library (id, name, category, ECMAScript
              <code>pattern</code>, <code>flags</code>, and a sample <code>example</code>) that also
              backs the <a href="/regex/">Regex Test</a> page. Optional <code>category</code> and
              <code>search</code> filters; <code>json</code> or <code>csv</code> output.
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </details>

  <CyberhavenAd unit="medium-rectangle" />

  <!-- ── BACKGROUND ────────────────────────────────────────── -->
  <details class="accordion accordion--section">
    <summary>Background: Why this exists &amp; sanctioned vs unsanctioned servers</summary>
    <div class="accordion-body">
      <p>
        DLP, CASB, and endpoint vendors increasingly claim they can inspect "agentic" or "AI tool"
        traffic. The most common transport for that traffic today is MCP — JSON-RPC 2.0 over HTTP.
        There are three distinct vectors to test:
      </p>
      <ul>
        <li><strong>Network / SSL inspection.</strong> Does your proxy decrypt and scan a <code>tools/call</code> response containing hundreds of fake SSNs?</li>
        <li><strong>Endpoint agent.</strong> Does the agent see both the outbound tool-call arguments <em>and</em> the data returned to the LLM?</li>
        <li><strong>CASB / browser extension.</strong> Does anything flag a connection to an unfamiliar external MCP server during the initial handshake?</li>
      </ul>
      <p>
        This endpoint is intentionally public and unauthenticated — it represents an <em>unsanctioned</em>
        external server. A sanctioned internal MCP server, by contrast, requires an
        <code>Authorization: Bearer &lt;token&gt;</code> header and is reachable only from the corporate
        network or via VPN. The presence of an auth token flowing to an external endpoint is itself a DLP
        signal worth alerting on.
      </p>
      <p>What your CASB or network DLP should detect when an agent connects here:</p>
      <ul>
        <li>An outbound connection to <code>mcp.dlptest.com</code> (or any <code>mcp.*</code> domain not in the approved list).</li>
        <li>A <code>tools/list</code> response — the fingerprint of an MCP handshake — from an unknown host.</li>
        <li>Any <code>Authorization</code> token leaving the network to an unapproved destination.</li>
      </ul>
      <p>
        The endpoint speaks the
        <a href="https://modelcontextprotocol.io/specification/2025-06-18/basic/transports" target="_blank" rel="noopener noreferrer">Streamable HTTP</a>
        transport in stateless mode. Each request is a self-contained <code>POST</code>; no session IDs
        are issued and no <code>GET</code> stream is held open.
      </p>
    </div>
  </details>

</BaseLayout>

<style>
  /* ── Accordion ─────────────────────────────────────── */
  .accordion {
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    margin: 0.5rem 0;
    overflow: hidden;
  }

  .accordion summary {
    cursor: pointer;
    padding: 0.8rem 1rem;
    font-weight: 600;
    font-size: 0.95rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    list-style: none;
    user-select: none;
    background: var(--bg-elev);
    transition: background var(--transition-fast);
  }

  .accordion summary::-webkit-details-marker { display: none; }

  .accordion summary::after {
    content: '';
    width: 8px;
    height: 8px;
    border-right: 2px solid var(--text-dim);
    border-bottom: 2px solid var(--text-dim);
    transform: rotate(45deg);
    transition: transform var(--transition-fast);
    margin-left: auto;
    flex-shrink: 0;
  }

  .accordion[open] > summary::after {
    transform: rotate(-135deg);
  }

  .accordion summary:hover {
    background: var(--surface);
  }

  .accordion-body {
    padding: 1rem 1rem 0.75rem;
    border-top: 1px solid var(--border);
  }

  .accordion-body > *:first-child { margin-top: 0; }
  .accordion-body > *:last-child  { margin-bottom: 0; }

  .accordion-body pre { margin: 0.75rem 0; }

  .accordion h4 {
    font-size: 0.9rem;
    margin: 1.25rem 0 0.35rem;
    color: var(--text);
  }

  .accordion--section {
    margin-top: 2rem;
    border-color: var(--border);
  }

  .accordion--section > summary {
    font-size: 1rem;
    color: var(--text-dim);
  }

  /* ── Step labels ───────────────────────────────────── */
  .step {
    font-size: 0.85rem;
    color: var(--text-dim);
    margin: 1rem 0 0.35rem;
  }
  .step:first-child { margin-top: 0; }

  /* ── Badge ─────────────────────────────────────────── */
  .badge {
    font-size: 0.7rem;
    font-weight: 600;
    padding: 0.15em 0.5em;
    border-radius: 4px;
    background: var(--surface);
    color: var(--text-dim);
    border: 1px solid var(--border);
    vertical-align: middle;
    margin-left: 0.25rem;
  }

  /* ── Setup grid ────────────────────────────────────── */
  .setup-grid {
