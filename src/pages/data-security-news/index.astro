---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

export const prerender = true;

// Pull every news entry and sort newest-first by pubDate. This route exists at
// /data-security-news/ to preserve the legacy WordPress aggregator URL.
const posts = (await getCollection("news"))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

function fmt(d: Date) {
  return d.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
}

const totalCount = posts.length;
const featured = posts[0];
const rest = posts.slice(1);
---
<BaseLayout
  title="Data Security News"
  description="Industry news and analysis on DLP, DSPM, insider risk, and data security from DLP Test."
>
  <header class="news-header">
    <h1>Data Security News</h1>
    <p class="news-lede">
      At DLP Test, we try to keep up with the latest news regarding data
      security vendors — funding rounds, acquisitions, product launches, and
      the occasional opinion piece. {totalCount} {totalCount === 1 ? "post" : "posts"}.
    </p>
    <p class="muted small">
      If you have news that's missing, use the <a href="/contact/">contact page</a> to get in touch.
    </p>
  </header>

  {featured && (
    <article class="news-featured">
      <div class="news-eyebrow">
        <span class="news-pill">Featured</span>
        <time datetime={featured.data.pubDate.toISOString()}>{fmt(featured.data.pubDate)}</time>
      </div>
      <h2>
        <a href={`/${featured.data.slug}/`}>{featured.data.title}</a>
      </h2>
      {featured.data.excerpt && <p>{featured.data.excerpt}</p>}
      <p>
        <a href={`/${featured.data.slug}/`}>Read more →</a>
      </p>
    </article>
  )}

  <ul class="news-list">
    {rest.map((post) => (
      <li class="news-item">
        <div class="news-eyebrow">
          <time datetime={post.data.pubDate.toISOString()}>{fmt(post.data.pubDate)}</time>
          {post.data.categories[0] && (
            <span class="news-cat">{post.data.categories[0]}</span>
          )}
        </div>
        <h3>
          <a href={`/${post.data.slug}/`}>{post.data.title}</a>
        </h3>
        {post.data.excerpt && <p>{post.data.excerpt}</p>}
      </li>
    ))}
  </ul>
</BaseLayout>
