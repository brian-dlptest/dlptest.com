---
import BaseLayout from "@/layouts/BaseLayout.astro";
import CyberhavenAd from "@/components/CyberhavenAd.astro";
export const prerender = true;

// The FTP test server lives on a separate host (ftp.dlptest.com) outside of
// Cloudflare. The password is intentionally public — it is published on
// this page so anyone can run tests. Rotate by updating this value and
// pushing through the normal staging -> main flow.
const ftpHost = "ftp.dlptest.com";
const ftpUser = "dlpuser";
const ftpPassword = "rNrKYTX9g7z3RgJRmxWuGHbeu";
const retentionMinutes = 10;

const s3Bucket = "dlptest-public-bucket";
const s3Region = "us-west-2";
const s3Endpoint = `https://${s3Bucket}.s3.${s3Region}.amazonaws.com`;
---
<BaseLayout title="FTP & S3 Test" description="Public FTP and S3 endpoints for testing DLP. Upload files without authentication; they are automatically deleted after a short retention period.">
  <div class="ftp-layout">
    <div class="ftp-content">
      <h1>FTP &amp; S3 Test</h1>

      <h2>FTP</h2>
      <p>
        Public FTP test server for uploading DLP test files. Uploaded files are
        deleted after about {retentionMinutes} minutes.
      </p>

      <table class="ftp-credentials-table">
        <tbody>
          <tr><th>FTP host</th><td><code>{ftpHost}</code></td></tr>
          <tr><th>User</th><td><code>{ftpUser}</code></td></tr>
          <tr><th>Password</th><td><code>{ftpPassword}</code></td></tr>
          <tr><th>Mode</th><td>Passive (active is not supported)</td></tr>
          <tr><th>Retention</th><td>{retentionMinutes} minutes</td></tr>
        </tbody>
      </table>

      <p>
        On Windows, use a client like
        <a href="https://filezilla-project.org/">FileZilla</a>; the active FTP
        transport built into <code>cmd.exe</code> does not support passive mode.
        Import our pre-configured FileZilla profile:
        <a href="/DLP_Test_FTP_FileZilla.xml">DLP_Test_FTP_FileZilla.xml</a>.
      </p>

      <h3>IP block list</h3>
      <p class="muted">
        To limit hosting costs from automated upload abuse, an IP block list is
        enforced. If you believe your address has been blocked in error, use the
        <a href="/contact/">contact page</a>.
      </p>

      <hr />

      <h2>S3</h2>
      <p>
        Public S3 bucket for testing cloud-storage DLP policies. No authentication
        required — upload any file with an HTTP <code>PUT</code>. Objects are
        automatically deleted after 24–48 hours via a lifecycle rule.
      </p>

      <table class="ftp-credentials-table">
        <tbody>
          <tr><th>Bucket</th><td><code>{s3Bucket}</code></td></tr>
          <tr><th>Region</th><td><code>{s3Region}</code></td></tr>
          <tr><th>Endpoint</th><td><code>{s3Endpoint}/FILENAME</code></td></tr>
          <tr><th>Auth</th><td>None (public PutObject)</td></tr>
          <tr><th>Retention</th><td>24–48 hours</td></tr>
        </tbody>
      </table>

      <h3>Upload (curl)</h3>
      <pre><code>curl -X PUT --upload-file "/path/to/testfile.txt" \
  {s3Endpoint}/testfile.txt</code></pre>

      <h3>Download (curl)</h3>
      <pre><code>curl -O {s3Endpoint}/testfile.txt</code></pre>

      <h3>Upload (Python boto3)</h3>
      <pre><code>import boto3
from botocore import UNSIGNED
from botocore.client import Config

s3 = boto3.client("s3", region_name="{s3Region}", config=Config(signature_version=UNSIGNED))
s3.upload_file("testfile.txt", "{s3Bucket}", "testfile.txt")</code></pre>
    </div>

    <CyberhavenAd unit="skyscraper" />
  </div>
</BaseLayout>

<style>
  .ftp-layout {
    display: grid;
    gap: 2rem;
    align-items: start;
  }

  .ftp-content {
    min-width: 0;
  }

  .ftp-credentials-table {
    width: auto;
    max-width: 100%;
    margin: 1.25rem 0 2rem;
    font-size: 0.92rem;
  }

  .ftp-credentials-table th,
  .ftp-credentials-table td {
    padding: 0.4rem 0.65rem;
  }

  .ftp-credentials-table th {
    width: 1%;
    white-space: nowrap;
    font-weight: 600;
  }

  .ftp-layout .cyberhaven-ad {
    margin: 0;
  }

  @media (min-width: 900px) {
    .ftp-layout {
      grid-template-columns: minmax(0, 1fr) auto;
    }
  }

  @media (max-width: 899px) {
    .ftp-layout .cyberhaven-ad {
      justify-self: center;
    }
  }
</style>
