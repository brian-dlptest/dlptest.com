---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SponsorAd from "@/components/SponsorAd.astro";
import { ADS_ENABLED } from "@/lib/sponsor-ad";
import {
  FILEZILLA_PROFILE_HREF,
  FILEZILLA_PROFILE_KEY,
  FTP_HOST as ftpHost,
  FTP_PASSWORD as ftpPassword,
  FTP_RETENTION_MINUTES as retentionMinutes,
  FTP_USER as ftpUser,
} from "@/data/ftp";
export const prerender = true;

// Credentials live in src/data/ftp.ts, which also builds the FileZilla
// profile, so rotate the password there.

const s3Bucket = "dlptest-public-bucket";
const s3Region = "us-west-2";
const s3Endpoint = `https://${s3Bucket}.s3.${s3Region}.amazonaws.com`;
---
<BaseLayout title="FTP & S3 Test" description="Public FTP and S3 sites for testing DLP. Upload your test files and they get deleted automatically.">
  <div class:list={["ftp-layout", { "ftp-layout--with-ad": ADS_ENABLED }]}>
    <div class="ftp-content">
      <h1>FTP &amp; S3 Test</h1>

      <h2>FTP</h2>
      <p>
        Our public FTP test site info is below. Use it to upload test DLP files.
        Files are deleted after about {retentionMinutes} minutes.
      </p>

      <table class="ftp-credentials-table">
        <tbody>
          <tr><th>FTP host</th><td><code>{ftpHost}</code></td></tr>
          <tr><th>User</th><td><code>{ftpUser}</code></td></tr>
          <tr><th>Password</th><td><code>{ftpPassword}</code></td></tr>
          <tr><th>Mode</th><td>Passive (active is not supported)</td></tr>
          <tr><th>Encryption</th><td>Optional; explicit FTPS (<code>AUTH TLS</code>) is supported</td></tr>
          <tr><th>Retention</th><td>{retentionMinutes} minutes</td></tr>
        </tbody>
      </table>

      <p>
        On Windows, use a client like <a href="https://filezilla-project.org/">FileZilla</a>,
        since the FTP client built into <code>cmd.exe</code> doesn't support
        passive mode. Here's a FileZilla profile you can import: <a href={FILEZILLA_PROFILE_HREF}>{FILEZILLA_PROFILE_KEY}</a>.
        It uses plain FTP so network DLP can see the file contents. To test an
        encrypted transfer, set the site's encryption to <em>Require explicit FTP over TLS</em>.
      </p>

      <h3>IP block list</h3>
      <p class="muted">
        Due to scripts uploading excess data and increasing costs to host the FTP
        server, an IP block list has been added. If you feel that I am blocking an
        IP incorrectly, please use the <a href="/contact/">contact page</a> to reach me.
      </p>

      <hr />

      <h2>S3</h2>
      <p>
        This is a public S3 bucket for testing cloud storage DLP policies. You
        don't need to log in. Just upload a file with an HTTP <code>PUT</code>.
        Files are deleted after 24 to 48 hours.
      </p>

      <table class="ftp-credentials-table">
        <tbody>
          <tr><th>Bucket</th><td><code>{s3Bucket}</code></td></tr>
          <tr><th>Region</th><td><code>{s3Region}</code></td></tr>
          <tr><th>Endpoint</th><td><code>{s3Endpoint}/FILENAME</code></td></tr>
          <tr><th>Auth</th><td>None (public PutObject)</td></tr>
          <tr><th>Retention</th><td>24–48 hours</td></tr>
        </tbody>
      </table>

      <h3>Upload (curl)</h3>
      <pre><code>curl -X PUT --upload-file "/path/to/testfile.txt" \
  {s3Endpoint}/testfile.txt</code></pre>

      <h3>Download (curl)</h3>
      <pre><code>curl -O {s3Endpoint}/testfile.txt</code></pre>

      <h3>Upload (Python boto3)</h3>
      <pre><code>import boto3
from botocore import UNSIGNED
from botocore.client import Config

s3 = boto3.client("s3", region_name="{s3Region}", config=Config(signature_version=UNSIGNED))
s3.upload_file("testfile.txt", "{s3Bucket}", "testfile.txt")</code></pre>
    </div>

    <SponsorAd unit="skyscraper" />
  </div>
</BaseLayout>

<style>
  .ftp-layout {
    display: grid;
    gap: 2rem;
    align-items: start;
  }

  .ftp-content {
    min-width: 0;
  }

  .ftp-credentials-table {
    width: auto;
    max-width: 100%;
    margin: 1.25rem 0 2rem;
    font-size: 0.92rem;
  }

  .ftp-credentials-table th,
  .ftp-credentials-table td {
    padding: 0.4rem 0.65rem;
  }

  .ftp-credentials-table th {
    width: 1%;
    white-space: nowrap;
    font-weight: 600;
  }

  .ftp-layout .sponsor-ad {
    margin: 0;
  }

  @media (min-width: 900px) {
    /* Only reserve the sidebar column when an ad fills it; an empty auto track
       still costs the column gap. */
    .ftp-layout--with-ad {
      grid-template-columns: minmax(0, 1fr) auto;
    }
  }

  @media (max-width: 899px) {
    .ftp-layout .sponsor-ad {
      justify-self: center;
    }
  }
</style>
