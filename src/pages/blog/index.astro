---
import BaseLayout from "@/layouts/BaseLayout.astro";
export const prerender = true;

// TODO: Wire up Astro content collections under src/content/blog/*.md. For now
// this is a stub so the route exists and the nav link doesn't 404.
const posts: Array<{ slug: string; title: string; date: string; excerpt: string }> = [
  // Sample entries — these will be replaced by content-collection-driven posts
  // ported from the live WordPress site, then by AI-drafted PRs going forward.
  // {
  //   slug: "endpoint-agents-are-essential",
  //   title: "The Hard Truth About DLP: Why Endpoint Agents Are Essential",
  //   date: "2026-05-01",
  //   excerpt: "Agentless sounds great in pitches, but if you want real DLP and effective insider risk protection, an endpoint agent is non-negotiable.",
  // },
];
---
<BaseLayout title="Blog" description="DLP, DSPM, and data-security industry analysis from DLP Test.">
  <h1>DLP Test Blog</h1>
  <p>
    Industry analysis on DLP, DSPM, insider risk, and the broader data-security
    market.
  </p>
  {posts.length === 0 ? (
    <p class="muted">
      Posts from the legacy WordPress site are being ported. Once ported, new
      drafts will arrive as pull requests in this repository — review, edit,
      and merge to publish.
    </p>
  ) : (
    <ul class="download-list">
      {posts.map((p) => (
        <li>
          <a href={`/blog/${p.slug}/`}><strong>{p.title}</strong></a>
          <div class="muted small">{p.date}</div>
          <p>{p.excerpt}</p>
        </li>
      ))}
    </ul>
  )}
</BaseLayout>
