---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { verifyAccess } from "@/lib/access";
import {
  fetchTrafficSummary,
  AnalyticsConfigError,
  type TrafficSummary,
} from "@/lib/cf-analytics";
import { env } from "cloudflare:workers";
import { loadVisitorSummary, type CountRow, type VisitorSummary } from "@/lib/page-views";
import { loadMcpSummary, type McpCountRow, type McpSummary } from "@/lib/mcp-calls";
import { envNameFor } from "@/lib/visitor";

// Traffic dashboard — a single pane to answer "how much traffic are we getting,
// and is anything hammering us?". Server-rendered and gated by Cloudflare Access
// (verified again at the origin). Reads Cloudflare's zone HTTP analytics, which
// is the only source that sees per-IP / per-user-agent breakdowns and edge-only
// traffic (e.g. a runaway client POSTing / and getting 405) that never reaches
// the Worker.
export const prerender = false;

const access = await verifyAccess(Astro.request);
if (!access.ok) {
  return new Response(`Forbidden: ${access.reason}`, { status: access.status });
}

const hoursParam = Number(Astro.url.searchParams.get("hours"));
const windowHours = [1, 6, 24, 168].includes(hoursParam) ? hoursParam : 24;

// Visitors have their own window (in days): Cloudflare maxes at 7d, but our
// page-view log is where we look for longer-term trends. Defaults to 28d.
const vDaysParam = Number(Astro.url.searchParams.get("vdays"));
const vDays = [7, 28, 90].includes(vDaysParam) ? vDaysParam : 28;

// Build a relative URL that flips one query param but preserves the others, so
// the Cloudflare and visitor window pills don't clobber each other's selection.
function withParam(key: string, value: string | number): string {
  const p = new URLSearchParams(Astro.url.search);
  p.set(key, String(value));
  return `?${p.toString()}`;
}

// Scope analytics to the hostname this dashboard is served on. dlptest.com and
// staging.dlptest.com share one Cloudflare zone, so without this each
// environment would show the whole zone's traffic (prod + staging combined).
const host = Astro.url.hostname;

let summary: TrafficSummary | null = null;
let loadError: string | null = null;
let notConfigured = false;
try {
  summary = await fetchTrafficSummary(windowHours, host);
} catch (error) {
  if (error instanceof AnalyticsConfigError) {
    notConfigured = true;
    loadError = error.message;
  } else {
    console.error("[admin/traffic] failed to load analytics:", error);
    loadError = error instanceof Error ? error.message : "Could not load analytics.";
  }
}

// First-party page views (cookieless; replaced Google Analytics in 2026-11),
// shown next to the Cloudflare numbers. Failures are isolated from the
// Cloudflare panel: one source being down must not blank the other.
const envName = envNameFor(Astro.url, env.ENVIRONMENT);
let visitors: VisitorSummary | null = null;
let visitorsError: string | null = null;
try {
  visitors = await loadVisitorSummary(envName, vDays);
} catch (error) {
  console.error("[admin/traffic] failed to load page views:", error);
  visitorsError = error instanceof Error ? error.message : "Could not load page views.";
}

// MCP server calls (src/lib/mcp-calls.ts), same window as Visitors. Isolated like
// the other sources: if this fails, the rest of the page still renders.
let mcp: McpSummary | null = null;
let mcpError: string | null = null;
try {
  mcp = await loadMcpSummary(envName, vDays);
} catch (error) {
  console.error("[admin/traffic] failed to load MCP calls:", error);
  mcpError = error instanceof Error ? error.message : "Could not load MCP calls.";
}
const mcpMax = mcp ? Math.max(1, ...mcp.daily.map((x) => x.toolCalls)) : 1;
const mcpTables: { title: string; hint?: string; rows: McpCountRow[]; mono?: boolean; count: string }[] = mcp
  ? [
      { title: "Tools", rows: mcp.tools, mono: true, count: "Calls" },
      {
        title: "Clients",
        hint: "The name a client sends when it connects (initialize). Most connect once per session.",
        rows: mcp.clients,
        count: "Connects",
      },
      {
        title: "User agents",
        hint: "First product in the User-Agent header, all methods.",
        rows: mcp.agents,
        mono: true,
        count: "Requests",
      },
      {
        title: "Networks",
        hint: "Who owns the caller's IP (ASN). Hosted AI assistants call from their provider's cloud.",
        rows: mcp.networks,
        count: "Requests",
      },
      { title: "Countries", rows: mcp.countries, count: "Requests" },
    ]
  : [];

// Trend signal: average daily visitors over the most recent N complete days vs
// the first N days of the window. Direct answer to "are we losing visitors?".
// N scales with the window (two weeks for 90d) but never exceeds half the series.
const vWindows = [
  { d: 7, label: "7d" },
  { d: 28, label: "28d" },
  { d: 90, label: "90d" },
];
const today = new Date().toISOString().slice(0, 10);
let visitorsTrendPct: number | null = null;
let trendN = 0;
if (visitors) {
  const d = visitors.daily.filter((x) => x.day < today);
  if (d.length >= 8) {
    trendN = Math.min(visitors.days >= 60 ? 14 : 7, Math.floor(d.length / 2));
    const avg = (rows: typeof d) => rows.reduce((sum, x) => sum + x.visitors, 0) / rows.length;
    const baseAvg = avg(d.slice(0, trendN));
    const recentAvg = avg(d.slice(-trendN));
    if (baseAvg > 0) visitorsTrendPct = Math.round(((recentAvg - baseAvg) / baseAvg) * 100);
  }
}
const visitorsMax = visitors ? Math.max(1, ...visitors.daily.map((x) => x.visitors)) : 1;
// Print the numbers on the chart when few enough bars fit. The 7d window always
// qualifies; wider windows fall back to the dense hover-only sparkline.
const showDayLabels = visitors ? visitors.daily.length > 0 && visitors.daily.length <= 14 : false;
const visitorTables: { title: string; hint?: string; rows: CountRow[]; mono?: boolean }[] = visitors
  ? [
      { title: "Top pages", rows: visitors.topPages, mono: true },
      { title: "Referrers", hint: "Other sites that sent visitors here.", rows: visitors.referrers, mono: true },
      {
        title: "Networks",
        hint: "Who owns the visitor's IP (ASN). Corporate traffic behind an SSE proxy shows as the proxy vendor.",
        rows: visitors.networks,
      },
      { title: "Countries", rows: visitors.countries },
      { title: "Devices", rows: visitors.devices },
    ]
  : [];

const nf = new Intl.NumberFormat("en-US");
function fmtBytes(n: number): string {
  if (!n) return "0 B";
  const units = ["B", "KB", "MB", "GB", "TB"];
  const i = Math.min(units.length - 1, Math.floor(Math.log(n) / Math.log(1024)));
  return `${(n / 1024 ** i).toFixed(i === 0 ? 0 : 1)} ${units[i]}`;
}
function shorten(s: string, max = 60): string {
  return s.length > max ? `${s.slice(0, max - 1)}…` : s;
}
function statusClass(code: number): string {
  if (code >= 500) return "s5";
  if (code >= 400) return "s4";
  if (code >= 300) return "s3";
  return "s2";
}

// Share of total carried by the single busiest IP — the headline "is one bot
// dominating?" number.
const topShare =
  summary && summary.totalRequests > 0 && summary.byIP[0]
    ? Math.round((summary.byIP[0].count / summary.totalRequests) * 100)
    : 0;

const hourlyMax = summary ? Math.max(1, ...summary.hourly.map((h) => h.count)) : 1;

const windows: { h: number; label: string }[] = [
  { h: 1, label: "1h" },
  { h: 6, label: "6h" },
  { h: 24, label: "24h" },
  { h: 168, label: "7d" },
];
---

<BaseLayout title="Traffic" description="Internal traffic dashboard.">
  <h1>Traffic</h1>
  <p class="muted">
    Cloudflare zone analytics for <strong>{host}</strong>.
    {access.email && <span>Signed in as {access.email}.</span>}
  </p>

  <div class="windows">
    {windows.map((w) => (
      <a class={`pill ${w.h === windowHours ? "pill--on" : ""}`} href={withParam("hours", w.h)}>{w.label}</a>
    ))}
  </div>

  {notConfigured && (
    <div class="flash flash--warn">
      <strong>Analytics not configured.</strong> {loadError}
    </div>
  )}
  {loadError && !notConfigured && (
    <div class="flash flash--err">Could not load analytics: <code>{loadError}</code></div>
  )}

  {summary && (
    <>
      <div class="cards">
        <div class="card">
          <div class="k">Requests</div>
          <div class="v">{nf.format(summary.totalRequests)}</div>
          <div class="sub">last {windowHours >= 24 ? `${windowHours / 24}d` : `${windowHours}h`}</div>
        </div>
        <div class="card">
          <div class="k">Bandwidth</div>
          <div class="v">{fmtBytes(summary.totalBytes)}</div>
          <div class="sub">edge response bytes</div>
        </div>
        <div class={`card ${topShare >= 50 ? "card--alert" : ""}`}>
          <div class="k">Top IP share</div>
          <div class="v">{topShare}%</div>
          <div class="sub">{topShare >= 50 ? "one source dominating" : "well distributed"}</div>
        </div>
      </div>

      <section>
        <h2>Requests per hour</h2>
        <div class="spark">
          {summary.hourly.map((h) => (
            <div
              class="bar"
              style={`height:${Math.max(2, Math.round((h.count / hourlyMax) * 100))}%`}
              title={`${h.dimensions.datetimeHour.slice(5, 16).replace("T", " ")} UTC · ${nf.format(h.count)}`}
            />
          ))}
        </div>
        <p class="hint">Hover a bar for the hour + count (UTC). A flat line around the clock = automated traffic.</p>
      </section>

      <div class="grid">
        <section>
          <h2>Top IPs</h2>
          <table>
            <thead><tr><th>IP</th><th>ASN</th><th>Country</th><th class="num">Requests</th></tr></thead>
            <tbody>
              {summary.byIP.map((r) => (
                <tr>
                  <td class="mono">{r.dimensions.clientIP}</td>
                  <td class="mono">{r.dimensions.clientAsn}</td>
                  <td>{r.dimensions.clientCountryName}</td>
                  <td class="num">{nf.format(r.count)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </section>

        <section>
          <h2>Top paths</h2>
          <table>
            <thead><tr><th>Path</th><th class="num">Requests</th></tr></thead>
            <tbody>
              {summary.byPath.map((r) => (
                <tr>
                  <td class="mono">{shorten(r.dimensions.clientRequestPath)}</td>
                  <td class="num">{nf.format(r.count)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </section>

        <section>
          <h2>Top user-agents</h2>
          <table>
            <thead><tr><th>User-agent</th><th class="num">Requests</th></tr></thead>
            <tbody>
              {summary.byUserAgent.map((r) => (
                <tr>
                  <td class="mono" title={r.dimensions.userAgent}>{shorten(r.dimensions.userAgent, 50)}</td>
                  <td class="num">{nf.format(r.count)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </section>

        <section>
          <h2>Status codes</h2>
          <table>
            <thead><tr><th>Code</th><th class="num">Requests</th></tr></thead>
            <tbody>
              {summary.byStatus.map((r) => (
                <tr>
                  <td><span class={`badge ${statusClass(r.dimensions.edgeResponseStatus)}`}>{r.dimensions.edgeResponseStatus}</span></td>
                  <td class="num">{nf.format(r.count)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </section>
      </div>

      <p class="gen">
        Window: {summary.start} → {summary.end} (UTC). Counts are Cloudflare adaptive
        estimates. Generated {new Date().toISOString().slice(0, 16).replace("T", " ")} UTC.
      </p>
    </>
  )}

  <section class="visitors">
    <h2>Visitors <span class="tag">first-party, no cookies</span></h2>
    <p class="hint">
      Counted by our own page-view beacon on <strong>{envName}</strong>. Only browsers that
      ran the page's script count, and bot user agents are dropped, so these sit well below
      the edge request counts above. Visitors are counted per day (the hash resets every UTC
      day), so one person on three days counts three times. Today is partial.
    </p>

    <div class="windows">
      {vWindows.map((w) => (
        <a class={`pill ${w.d === vDays ? "pill--on" : ""}`} href={withParam("vdays", w.d)}>{w.label}</a>
      ))}
    </div>

    {visitorsError && (
      <div class="flash flash--err">Could not load page views: <code>{visitorsError}</code></div>
    )}

    {visitors && (
      <>
        <div class="cards">
          <div class="card">
            <div class="k">Page views</div>
            <div class="v">{nf.format(visitors.pageViews)}</div>
            <div class="sub">last {visitors.days}d</div>
          </div>
          <div class="card">
            <div class="k">Visitors</div>
            <div class="v">{nf.format(visitors.dailyVisitors)}</div>
            <div class="sub">summed per day</div>
          </div>
          <div class="card">
            <div class="k">Visits</div>
            <div class="v">{nf.format(visitors.visits)}</div>
            <div class="sub">arrived from outside the site</div>
          </div>
          {visitorsTrendPct !== null && (
            <div class={`card ${visitorsTrendPct < -5 ? "card--alert" : ""}`}>
              <div class="k">Visitors trend</div>
              <div class="v">{visitorsTrendPct > 0 ? "▲" : visitorsTrendPct < 0 ? "▼" : "■"} {Math.abs(visitorsTrendPct)}%</div>
              <div class="sub">last {trendN}d avg vs first {trendN}d</div>
            </div>
          )}
        </div>

        {visitors.daily.length > 0 && (
          <section>
            <h2>Visitors per day</h2>
            <div class:list={["spark", { "spark--labeled": showDayLabels }]}>
              {visitors.daily.map((d) => {
                const h = Math.max(2, Math.round((d.visitors / visitorsMax) * 100));
                const tip = `${d.day} · ${nf.format(d.visitors)} visitors · ${nf.format(d.views)} views`;
                return showDayLabels ? (
                  <div class="col" title={tip}>
                    <div class="col__track">
                      <div class="bar" style={`height:${h}%`} />
                      <span class="col__val" style={`bottom:calc(${h}% + 0.25rem)`}>{nf.format(d.visitors)}</span>
                    </div>
                    <span class="col__day">{d.day.slice(5)}</span>
                  </div>
                ) : (
                  <div class="bar" style={`height:${h}%`} title={tip} />
                );
              })}
            </div>
            <p class="hint">
              {showDayLabels
                ? "Each bar is labelled with its visitor count; hover for views too."
                : "Hover a bar for the date and counts."}
              {" "}A sustained downward slope means losing visitors.
            </p>
          </section>
        )}

        <div class="grid">
          {visitorTables.map((t) => (
            <section>
              <h2>{t.title}</h2>
              {t.hint && <p class="hint">{t.hint}</p>}
              {t.rows.length === 0 ? (
                <p class="hint">No data yet.</p>
              ) : (
                <table>
                  <thead><tr><th></th><th class="num">Visitors</th><th class="num">Views</th></tr></thead>
                  <tbody>
                    {t.rows.map((r) => (
                      <tr>
                        <td class={t.mono ? "mono" : ""}>{t.mono ? shorten(r.key) : r.key}</td>
                        <td class="num">{nf.format(r.visitors)}</td>
                        <td class="num">{nf.format(r.views)}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              )}
            </section>
          ))}
        </div>
      </>
    )}
  </section>

  <section class="visitors">
    <h2>MCP server <span class="tag">first-party</span></h2>
    <p class="hint">
      Requests to the MCP server at <code>mcp.dlptest.com</code> and <code>/api/mcp/</code> on <strong>{envName}</strong>,
      same window as Visitors. Arguments and results aren't stored,
      only which tool was called and whether it worked. Callers are counted per day, like
      visitors. Today is partial.
    </p>

    {mcpError && (
      <div class="flash flash--err">Could not load MCP calls: <code>{mcpError}</code></div>
    )}

    {mcp && (
      <>
        <div class="cards">
          <div class="card">
            <div class="k">Tool calls</div>
            <div class="v">{nf.format(mcp.toolCalls)}</div>
            <div class="sub">last {mcp.days}d</div>
          </div>
          <div class="card">
            <div class="k">Callers</div>
            <div class="v">{nf.format(mcp.dailyCallers)}</div>
            <div class="sub">summed per day</div>
          </div>
          <div class="card">
            <div class="k">Connects</div>
            <div class="v">{nf.format(mcp.connections)}</div>
            <div class="sub">initialize requests</div>
          </div>
          <div class={`card ${mcp.toolCalls > 0 && mcp.toolErrors / mcp.toolCalls > 0.2 ? "card--alert" : ""}`}>
            <div class="k">Tool errors</div>
            <div class="v">{mcp.toolCalls ? `${Math.round((mcp.toolErrors / mcp.toolCalls) * 100)}%` : "–"}</div>
            <div class="sub">{nf.format(mcp.toolErrors)} calls returned an error</div>
          </div>
        </div>

        {mcp.daily.length > 0 && (
          <section>
            <h2>Tool calls per day</h2>
            <div class:list={["spark", { "spark--labeled": mcp.daily.length <= 14 }]}>
              {mcp.daily.map((d) => {
                const h = Math.max(2, Math.round((d.toolCalls / mcpMax) * 100));
                const tip = `${d.day} · ${nf.format(d.toolCalls)} tool calls · ${nf.format(d.callers)} callers`;
                return mcp!.daily.length <= 14 ? (
                  <div class="col" title={tip}>
                    <div class="col__track">
                      <div class="bar" style={`height:${h}%`} />
                      <span class="col__val" style={`bottom:calc(${h}% + 0.25rem)`}>{nf.format(d.toolCalls)}</span>
                    </div>
                    <span class="col__day">{d.day.slice(5)}</span>
                  </div>
                ) : (
                  <div class="bar" style={`height:${h}%`} title={tip} />
                );
              })}
            </div>
            <p class="hint">Hover a bar for the date and counts. Only days with at least one request show up.</p>
          </section>
        )}

        <div class="grid">
          {mcpTables.map((t) => (
            <section>
              <h2>{t.title}</h2>
              {t.hint && <p class="hint">{t.hint}</p>}
              {t.rows.length === 0 ? (
                <p class="hint">No data yet.</p>
              ) : (
                <table>
                  <thead><tr><th></th><th class="num">{t.count}</th><th class="num">Callers</th><th class="num">Errors</th></tr></thead>
                  <tbody>
                    {t.rows.map((r) => (
                      <tr>
                        <td class={t.mono ? "mono" : ""}>{t.mono ? shorten(r.key) : r.key}</td>
                        <td class="num">{nf.format(r.calls)}</td>
                        <td class="num">{nf.format(r.callers)}</td>
                        <td class="num">{r.errors ? nf.format(r.errors) : ""}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              )}
            </section>
          ))}
        </div>
      </>
    )}
  </section>
</BaseLayout>

<style>
  .muted { color: var(--text-dim); }
  .windows { display: flex; gap: 0.4rem; margin: 0.75rem 0 1.25rem; }
  .pill {
    border: 1px solid var(--border); border-radius: 999px; padding: 0.2rem 0.8rem;
    font-size: 0.85rem; color: var(--accent); text-decoration: none;
  }
  .pill--on { background: var(--accent); border-color: var(--accent); color: #fff; }
  .flash { padding: 0.6rem 0.9rem; border-radius: var(--radius-sm); margin: 0.75rem 0; font-size: 0.95rem; border: 1px solid var(--border); }
  .flash--warn { background: color-mix(in srgb, var(--warning) 14%, var(--surface)); border-color: var(--warning); }
  .flash--err { background: color-mix(in srgb, var(--danger) 14%, var(--surface)); border-color: var(--danger); }
  .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 1rem; margin: 1rem 0 1.5rem; }
  .card { border: 1px solid var(--border); border-radius: var(--radius); padding: 0.9rem 1.1rem; background: var(--surface); }
  .card--alert { border-color: var(--danger); background: color-mix(in srgb, var(--danger) 10%, var(--surface)); }
  .card .k { color: var(--text-dim); font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.03em; }
  .card .v { color: var(--text); font-size: 1.8rem; font-weight: 600; line-height: 1.2; }
  .card .sub { color: var(--text-dim); font-size: 0.8rem; }
  .spark { display: flex; align-items: flex-end; gap: 2px; height: 120px; padding: 0.5rem 0; }
  .spark .bar { flex: 1; min-width: 2px; background: var(--accent); border-radius: 2px 2px 0 0; opacity: 0.8; }
  .spark .bar:hover { opacity: 1; background: var(--accent-hover); }
  /* Labelled variant: used when few enough bars fit (see showDayLabels). The
     track gets an explicit height so the bars' percentage heights resolve
     against a definite parent rather than a flex-sized one. */
  .spark--labeled { height: auto; gap: 4px; padding-top: 1.25rem; }
  .spark--labeled .col { flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: center; gap: 0.3rem; }
  /* Track is positioned so each bar's value label can be pinned directly above
     its own bar (bottom: calc(height% + gap)) rather than floating in a
     detached row at the top of the chart. */
  .spark--labeled .col__track { position: relative; height: 110px; width: 100%; }
  .spark--labeled .col__track .bar { position: absolute; left: 0; right: 0; bottom: 0; }
  .spark--labeled .col__val {
    position: absolute; left: 0; right: 0; text-align: center;
    font-size: 0.75rem; font-weight: 600; color: var(--text); line-height: 1;
  }
  .spark--labeled .col__day { font-size: 0.7rem; color: var(--text-dim); line-height: 1; white-space: nowrap; }
  .hint, .gen { color: var(--text-dim); font-size: 0.8rem; }
  .gen { margin-top: 1.5rem; }
  .visitors { margin-top: 2.5rem; border-top: 1px solid var(--border); padding-top: 1.5rem; }
  .visitors > h2 { font-size: 1.2rem; margin: 0 0 0.25rem; color: var(--text); display: flex; align-items: center; gap: 0.6rem; }
  .visitors .tag {
    font-size: 0.7rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.03em;
    color: var(--accent); border: 1px solid var(--accent); border-radius: 999px; padding: 0.1rem 0.5rem;
  }
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1.5rem; margin-top: 1rem; }
  /* Grid/flex items default to min-width:auto, which lets a table's widest
     unbreakable cell (long IPv6 / path / user-agent) blow past the track and
     overlap the next column. Pin to 0 so the track governs width and the
     tables wrap instead of spilling. */
  .grid > section { min-width: 0; }
  section h2 { font-size: 1.05rem; margin: 0 0 0.5rem; color: var(--text); }
  table { width: 100%; border-collapse: collapse; font-size: 0.85rem; color: var(--text); table-layout: fixed; }
  th, td { text-align: left; padding: 0.35rem 0.5rem; border-bottom: 1px solid var(--border); }
  th { color: var(--text-dim); font-weight: 600; }
  th.num, td.num { text-align: right; white-space: nowrap; width: 5rem; }
  /* Break long technical strings so fixed-layout cells wrap rather than overflow. */
