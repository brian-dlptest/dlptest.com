---
import BaseLayout from "@/layouts/BaseLayout.astro";
import CyberhavenAdSlot from "@/components/CyberhavenAdSlot.astro";
import SampleDataNav from "@/components/SampleDataNav.astro";
import CopyRowScript from "@/components/CopyRowScript.astro";
import { sampleData, downloadFiles, humanSize } from "@/data/sample-data";
export const prerender = true;
---
<BaseLayout title="Sample Data — Names + SSN + CCN" description="Test PII/PCI data: fabricated names, Social Security Numbers, and credit card numbers for DLP testing.">
  <h1>Name + SSN + Credit Card Number</h1>
  <p>
    Fabricated PII/PCI test rows. Useful for verifying that your DLP detects
    composite patterns (e.g. an SSN alongside a credit card number).
  </p>

  <CyberhavenAdSlot page="sample-data-tab">
  <SampleDataNav active="ssncc" />

  <div class="table-scroll" data-copy-table>
    <table>
      <thead>
        <tr>
          <th>First and Last Name</th>
          <th>SSN</th>
          <th>Credit Card Number</th>
        </tr>
      </thead>
      <tbody>
        {sampleData.map((row) => (
          <tr>
            <td>{row.name}</td>
            <td><code>{row.ssn}</code></td>
            <td><code>{row.ccn}</code></td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <CopyRowScript />
  <h2>Sample files</h2>
  <h3>Sample SSN &amp; CCN files</h3>
  <ul class="download-list">
    {downloadFiles.filter((f) => f.group === "sample").map((f) => (
      <li><a href={`/${f.key}`}>{f.label}</a> <span class="muted small">({humanSize(f.approxBytes)})</span></li>
    ))}
  </ul>
  </CyberhavenAdSlot>
</BaseLayout>
