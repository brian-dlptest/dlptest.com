---
import BaseLayout from "@/layouts/BaseLayout.astro";
import CyberhavenAdSlot from "@/components/CyberhavenAdSlot.astro";
import SampleDataNav from "@/components/SampleDataNav.astro";
import CopyRowScript from "@/components/CopyRowScript.astro";
import { sampleNameDobEmail, downloadFiles, humanSize } from "@/data/sample-data";
export const prerender = true;
---
<BaseLayout title="Sample Data — Names + DOB + Email" description="Test PII data: fabricated names, dates of birth, and email addresses for DLP testing.">
  <h1>Name + Date of Birth + Email</h1>
  <p>
    Fabricated PII test rows spanning common consumer email providers
    (gmail, hotmail, yahoo, aol, facebook). Useful for verifying detection
    of name-DOB-email composites.
  </p>

  <CyberhavenAdSlot page="sample-data-tab">
  <SampleDataNav active="dobemail" />

  <div class="table-scroll" data-copy-table>
    <table>
      <thead>
        <tr>
          <th>First Name</th>
          <th>Last Name</th>
          <th>Date of Birth</th>
          <th>Email</th>
        </tr>
      </thead>
      <tbody>
        {sampleNameDobEmail.map((row) => (
          <tr>
            <td>{row.first}</td>
            <td>{row.last}</td>
            <td><code>{row.dob}</code></td>
            <td><code>{row.email}</code></td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <CopyRowScript />
  <h2>Sample files</h2>
  <h3>Sample DOB &amp; Email files</h3>
  <ul class="download-list">
    {downloadFiles.filter((f) => f.group === "dobemail").map((f) => (
      <li><a href={`/${f.key}`}>{f.label}</a> <span class="muted small">({humanSize(f.approxBytes)})</span></li>
    ))}
  </ul>
  </CyberhavenAdSlot>
</BaseLayout>
