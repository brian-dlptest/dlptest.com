---
import BaseLayout from "@/layouts/BaseLayout.astro";
import CyberhavenAdSlot from "@/components/CyberhavenAdSlot.astro";
import SampleDataNav from "@/components/SampleDataNav.astro";
import CopyRowScript from "@/components/CopyRowScript.astro";
import { sampleNameCcnZip, downloadFiles, humanSize } from "@/data/sample-data";
export const prerender = true;
---
<BaseLayout title="Sample Data — Names + CCN + ZIP" description="Test PCI data: fabricated names, credit card numbers, ZIP codes, and expiration dates for DLP testing.">
  <h1>Name + Credit Card Number + ZIP + Expiration</h1>
  <p>
    Fabricated PCI test rows including Visa, Mastercard, American Express,
    Discover, and JCB number formats. Useful for testing PCI-DSS detection
    rules.
  </p>

  <CyberhavenAdSlot page="sample-data-tab" showSubscribe>
  <SampleDataNav active="ccnzip" />

  <div class="table-scroll" data-copy-table>
    <table>
      <thead>
        <tr>
          <th>First Name</th>
          <th>Last Name</th>
          <th>ZIP</th>
          <th>Credit Card Number</th>
          <th>Expiration</th>
        </tr>
      </thead>
      <tbody>
        {sampleNameCcnZip.map((row) => (
          <tr>
            <td>{row.first}</td>
            <td>{row.last}</td>
            <td><code>{row.zip}</code></td>
            <td><code>{row.ccn}</code></td>
            <td><code>{row.expiry}</code></td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <CopyRowScript />
  <h2>Sample files</h2>
  <h3>Sample CCN &amp; ZIP files</h3>
  <ul class="download-list">
    {downloadFiles.filter((f) => f.group === "ccnzip").map((f) => (
      <li><a href={`/${f.key}`}>{f.label}</a> <span class="muted small">({humanSize(f.approxBytes)})</span></li>
    ))}
  </ul>
  </CyberhavenAdSlot>
</BaseLayout>
