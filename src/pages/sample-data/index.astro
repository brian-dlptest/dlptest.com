---
import BaseLayout from "@/layouts/BaseLayout.astro";
import CyberhavenAdSlot from "@/components/CyberhavenAdSlot.astro";
import { sampleData, sampleNameSsnDob, sampleNameCcnZip, sampleNameDobEmail } from "@/data/sample-data";
import { libraryCategories } from "@/data/library-files";
export const prerender = true;

const datasetCards = [
  {
    id: "pii-ssn-ccn",
    label: "Name + SSN + CCN",
    description: "Social Security + Credit Card Numbers",
    subpage: "/sample-data/namessndob/",
    columns: ["Name", "SSN", "Credit Card Number"],
    rows: sampleData.map((r) => [r.name, r.ssn, r.ccn]),
  },
  {
    id: "pii-ssn-dob",
    label: "Name + SSN + DOB",
    description: "Social Security + Date of Birth",
    subpage: "/sample-data/namessndob/",
    columns: ["Name", "SSN", "Date of Birth"],
    rows: sampleNameSsnDob.map((r) => [r.name, r.ssn, r.dob]),
  },
  {
    id: "pci-ccn-zip",
    label: "Name + CCN + ZIP",
    description: "Credit Card + ZIP Code + Expiry",
    subpage: "/sample-data/nameccnzip/",
    columns: ["First Name", "Last Name", "ZIP", "Credit Card Number", "Expiry"],
    rows: sampleNameCcnZip.map((r) => [r.first, r.last, r.zip, r.ccn, r.expiry]),
  },
  {
    id: "pii-dob-email",
    label: "Name + DOB + Email",
    description: "Date of Birth + Email Address",
    subpage: "/sample-data/namedobemail/",
    columns: ["First Name", "Last Name", "Date of Birth", "Email"],
    rows: sampleNameDobEmail.map((r) => [r.first, r.last, r.dob, r.email]),
  },
];

// Serialize for client-side JS
const datasetsJson = Object.fromEntries(
  datasetCards.map((d) => [d.id, { label: d.label, columns: d.columns, rows: d.rows, subpage: d.subpage }])
);
const libraryJson = libraryCategories.map((c) => ({
  id: c.id,
  label: c.label,
  description: c.description,
  files: c.files.map((f) => ({ displayName: f.displayName, url: f.url, filename: f.filename })),
}));
---
<BaseLayout
  title="Sample Data Library"
  description="Fabricated PII and PCI test data for DLP testing — download as CSV, XLSX, PDF, or DOCX, or grab identity document images for OCR testing."
>
  <h1>Sample Data Library</h1>
  <p>
    Click any card to copy or download fabricated test data. All values are synthetic — safe to use
    as DLP detection targets. Identity document images are publicly available samples suitable for
    OCR and image-based DLP testing.
  </p>

  <CyberhavenAdSlot page="sample-data" showSubscribe>

  <section class="lib-section">
    <h2 class="section-heading">PII / PCI Test Datasets</h2>
    <div class="card-grid">
      {datasetCards.map((card) => (
        <button
          class="lib-card"
          type="button"
          data-card-type="dataset"
          data-dataset-id={card.id}
          aria-label={`Open options for ${card.label}`}
        >
          <span class="card-icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="3" width="18" height="18" rx="2"/>
              <line x1="3" y1="9" x2="21" y2="9"/>
              <line x1="3" y1="15" x2="21" y2="15"/>
              <line x1="9" y1="9" x2="9" y2="21"/>
            </svg>
          </span>
          <span class="card-label">{card.label}</span>
          <span class="card-desc">{card.description}</span>
          <span class="card-count muted">{card.rows.length} rows</span>
        </button>
      ))}
    </div>
  </section>

  <section class="lib-section">
    <h2 class="section-heading">Document Library Files</h2>
    <p class="muted small">Sample identity document images for OCR-based and image-content DLP testing.</p>
    <div class="card-grid">
      {libraryCategories.map((cat) => (
        <button
          class="lib-card"
          type="button"
          data-card-type="library"
          data-library-id={cat.id}
          aria-label={`Open file list for ${cat.label}`}
        >
          <span class="card-icon" aria-hidden="true">
            {cat.id === "drivers-licenses" && (
              <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="5" width="20" height="14" rx="2"/>
                <circle cx="8" cy="12" r="2"/>
                <line x1="13" y1="10" x2="19" y2="10"/>
                <line x1="13" y1="14" x2="19" y2="14"/>
              </svg>
            )}
            {cat.id === "medical-images" && (
              <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="18" height="18" rx="2"/>
                <line x1="12" y1="8" x2="12" y2="16"/>
                <line x1="8" y1="12" x2="16" y2="12"/>
              </svg>
            )}
            {cat.id === "passport-images" && (
              <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <rect x="4" y="2" width="16" height="20" rx="2"/>
                <circle cx="12" cy="10" r="3"/>
                <line x1="8" y1="17" x2="16" y2="17"/>
                <line x1="9" y1="20" x2="15" y2="20"/>
              </svg>
            )}
          </span>
          <span class="card-label">{cat.label}</span>
          <span class="card-desc">{cat.description}</span>
          <span class="card-count muted">{cat.files.length} files</span>
        </button>
      ))}
    </div>
  </section>

  <!-- Modal -->
  <dialog id="lib-modal" aria-modal="true">
    <div class="modal-header">
      <div>
        <h2 id="modal-title" class="modal-title"></h2>
        <p id="modal-desc" class="modal-desc muted small"></p>
      </div>
      <button id="modal-close" class="modal-close" aria-label="Close dialog">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"/>
          <line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </div>

    <!-- Dataset mode -->
    <div id="modal-dataset" class="modal-body" hidden>
      <p class="modal-hint muted small">All values are fabricated test data — not real PII.</p>
      <div class="modal-actions">
        <button id="btn-copy" class="action-btn" type="button">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
          Copy as plain text
        </button>
        <button id="btn-csv" class="action-btn" type="button">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="12" y1="18" x2="12" y2="12"/><line x1="9" y1="15" x2="15" y2="15"/></svg>
          Download CSV
        </button>
        <button id="btn-xlsx" class="action-btn" type="button">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="12" y1="18" x2="12" y2="12"/><line x1="9" y1="15" x2="15" y2="15"/></svg>
          Download XLSX
        </button>
        <button id="btn-pdf" class="action-btn" type="button">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="12" y1="18" x2="12" y2="12"/><line x1="9" y1="15" x2="15" y2="15"/></svg>
          Download PDF
        </button>
        <button id="btn-docx" class="action-btn" type="button">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="12" y1="18" x2="12" y2="12"/><line x1="9" y1="15" x2="15" y2="15"/></svg>
          Download DOCX
        </button>
      </div>
      <p id="copy-feedback" class="copy-feedback muted small" hidden>Copied to clipboard!</p>
      <a id="link-view-table" href="#" class="view-link">View full table →</a>
    </div>

    <!-- Library mode -->
    <div id="modal-library" class="modal-body" hidden>
      <ul id="modal-file-list" class="file-list"></ul>
    </div>
  </dialog>

  </CyberhavenAdSlot>
</BaseLayout>

<style>
  .lib-section {
    margin: 2rem 0;
  }
  .section-heading {
    font-size: 1.15rem;
    font-weight: 700;
    margin: 0 0 0.4rem;
    color: var(--text);
  }
  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
    gap: 1rem;
    margin-top: 1rem;
  }
  .lib-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    padding: 1.5rem 1rem 1rem;
    background: var(--bg-elev);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    cursor: pointer;
    text-align: center;
    transition: box-shadow var(--transition-fast), border-color var(--transition-fast), transform var(--transition-fast);
    color: var(--text);
    font: inherit;
  }
  .lib-card:hover {
    box-shadow: 0 4px 16px rgba(0,0,0,0.08);
    border-color: var(--text-dim);
    transform: translateY(-2px);
  }
  .lib-card:focus-visible {
    outline: 2px solid var(--text);
    outline-offset: 2px;
  }
  .card-icon {
    color: var(--text-dim);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    background: var(--bg);
    border-radius: 50%;
    margin-bottom: 0.25rem;
    border: 1px solid var(--border);
  }
  .lib-card:hover .card-icon {
    color: var(--text);
  }
  .card-label {
    font-weight: 700;
    font-size: 0.95rem;
    line-height: 1.2;
  }
  .card-desc {
    font-size: 0.8rem;
    color: var(--text-dim);
    line-height: 1.3;
  }
  .card-count {
    font-size: 0.75rem;
    margin-top: auto;
  }

  /* Modal */
  #lib-modal {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg);
    color: var(--text);
    padding: 0;
    max-width: min(480px, 90vw);
    width: 100%;
    box-shadow: 0 8px 32px rgba(0,0,0,0.18);
  }
  #lib-modal::backdrop {
    background: rgba(0,0,0,0.45);
  }
  .modal-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.25rem 1.25rem 0.75rem;
    border-bottom: 1px solid var(--border);
  }
  .modal-title {
    font-size: 1.1rem;
    font-weight: 700;
    margin: 0 0 0.2rem;
  }
  .modal-desc {
    margin: 0;
  }
  .modal-close {
    flex-shrink: 0;
    background: none;
    border: none;
    cursor: pointer;
    color: var(--text-dim);
    padding: 0.2rem;
    border-radius: var(--radius);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color var(--transition-fast);
  }
  .modal-close:hover {
    color: var(--text);
  }
  .modal-body {
    padding: 1.25rem;
  }
  .modal-hint {
    margin: 0 0 1rem;
  }
  .modal-actions {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .action-btn {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.65rem 1rem;
    background: var(--bg-elev);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text);
    font: inherit;
    font-size: 0.95rem;
    cursor: pointer;
    transition: background var(--transition-fast), border-color var(--transition-fast);
    text-align: left;
  }
  .action-btn:hover {
    background: var(--bg);
    border-color: var(--text-dim);
  }
  .action-btn svg {
    flex-shrink: 0;
    color: var(--text-dim);
  }
  .copy-feedback {
    margin: 0.5rem 0 0;
    color: var(--text-dim);
  }
  .view-link {
    display: inline-block;
    margin-top: 1rem;
    font-size: 0.85rem;
    color: var(--text-dim);
  }
  .file-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .file-list li a {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.6rem 0.75rem;
    background: var(--bg-elev);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text);
    text-decoration: none;
    font-size: 0.9rem;
    transition: background var(--transition-fast);
  }
  .file-list li a:hover {
    background: var(--bg);
    border-color: var(--text-dim);
  }
  .file-list .file-icon {
    color: var(--text-dim);
    flex-shrink: 0;
  }
</style>

<script define:vars={{ datasetsJson, libraryJson }}>
  const datasets = datasetsJson;
  const libraryData = libraryJson;

  const modal = document.getElementById("lib-modal");
  const modalTitle = document.getElementById("modal-title");
  const modalDesc = document.getElementById("modal-desc");
  const modalDataset = document.getElementById("modal-dataset");
  const modalLibrary = document.getElementById("modal-library");
  const modalClose = document.getElementById("modal-close");
  const fileList = document.getElementById("modal-file-list");
  const copyFeedback = document.getElementById("copy-feedback");
  const linkViewTable = document.getElementById("link-view-table");

  let activeDataset = null;

  // Open modal for dataset cards
  document.querySelectorAll("[data-card-type='dataset']").forEach((card) => {
    card.addEventListener("click", () => {
      const id = card.dataset.datasetId;
      activeDataset = datasets[id];
      if (!activeDataset) return;

      modalTitle.textContent = activeDataset.label;
      modalDesc.textContent = `${activeDataset.rows.length} rows · fabricated test data`;
      modalDataset.hidden = false;
      modalLibrary.hidden = true;
      copyFeedback.hidden = true;
      linkViewTable.href = activeDataset.subpage;
      modal.showModal();
    });
  });

  // Open modal for library cards
  document.querySelectorAll("[data-card-type='library']").forEach((card) => {
    card.addEventListener("click", () => {
      const id = card.dataset.libraryId;
      const cat = libraryData.find((c) => c.id === id);
      if (!cat) return;

      modalTitle.textContent = cat.label;
      modalDesc.textContent = cat.description;
      modalDataset.hidden = true;
      modalLibrary.hidden = false;

      fileList.innerHTML = "";
      cat.files.forEach((file) => {
        const li = document.createElement("li");
        const a = document.createElement("a");
        a.href = file.url;
        a.download = file.filename;
        a.innerHTML = `<svg class="file-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="12" y1="18" x2="12" y2="12"/><line x1="9" y1="15" x2="15" y2="15"/></svg>${file.displayName}`;
        li.appendChild(a);
        fileList.appendChild(li);
      });

      modal.showModal();
    });
  });

  // Close handlers
  modalClose.addEventListener("click", () => modal.close());
  modal.addEventListener("click", (e) => {
    if (e.target === modal) modal.close();
  });

  // ── Copy as plain text ──────────────────────────────────────────────────────
  document.getElementById("btn-copy").addEventListener("click", async () => {
    if (!activeDataset) return;
    const { columns, rows } = activeDataset;
    const text = [columns, ...rows].map((row) => row.join("\t")).join("\n");
    await navigator.clipboard.writeText(text);
    copyFeedback.hidden = false;
    setTimeout(() => { copyFeedback.hidden = true; }, 2000);
  });

  // ── CSV ─────────────────────────────────────────────────────────────────────
  document.getElementById("btn-csv").addEventListener("click", () => {
    if (!activeDataset) return;
    const { columns, rows, label } = activeDataset;
    function escapeCsv(v) {
      const s = String(v);
      return s.includes(",") || s.includes('"') || s.includes("\n") ? `"${s.replace(/"/g, '""')}"` : s;
    }
    const csv = [columns, ...rows].map((r) => r.map(escapeCsv).join(",")).join("\n");
    downloadBlob(new TextEncoder().encode(csv), slug(label) + ".csv", "text/csv");
  });

  // ── XLSX ────────────────────────────────────────────────────────────────────
  document.getElementById("btn-xlsx").addEventListener("click", async () => {
    if (!activeDataset) return;
    const { columns, rows, label } = activeDataset;
    const XLSX = await import("xlsx");
    const ws = XLSX.utils.aoa_to_sheet([columns, ...rows]);
    const wb = XLSX.utils.book_new();
    XLSX.utils.book_append_sheet(wb, ws, "DLP Test Data");
    const buf = XLSX.write(wb, { type: "array", bookType: "xlsx" });
    downloadBlob(new Uint8Array(buf), slug(label) + ".xlsx", "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
  });

  // ── PDF ─────────────────────────────────────────────────────────────────────
  document.getElementById("btn-pdf").addEventListener("click", async () => {
    if (!activeDataset) return;
    const { columns, rows, label } = activeDataset;
    const { PDFDocument, rgb, StandardFonts } = await import("pdf-lib");

    const doc = await PDFDocument.create();
    const font = await doc.embedFont(StandardFonts.Helvetica);
    const boldFont = await doc.embedFont(StandardFonts.HelveticaBold);

    const W = 792; // landscape letter
    const H = 612;
    const margin = 40;
    const fontSize = 8;
    const lineH = 13;
    const usable = W - margin * 2;
    const colW = usable / columns.length;

    let page = doc.addPage([W, H]);
    let y = H - margin;

    // Title
    page.drawText(`DLP Test — ${label}`, { x: margin, y, size: 11, font: boldFont, color: rgb(0, 0, 0) });
    y -= 18;
    page.drawText("Fabricated test data. Not real PII.", { x: margin, y, size: 7, font, color: rgb(0.5, 0.5, 0.5) });
    y -= 16;

    // Header row
    columns.forEach((col, i) => {
      page.drawText(String(col), { x: margin + i * colW, y, size: fontSize, font: boldFont, color: rgb(0, 0, 0) });
    });
    y -= 4;
    page.drawLine({ start: { x: margin, y }, end: { x: W - margin, y }, thickness: 0.5, color: rgb(0.6, 0.6, 0.6) });
    y -= lineH;

    // Data rows
    for (const row of rows) {
      if (y < margin + lineH) {
        page = doc.addPage([W, H]);
        y = H - margin;
      }
      row.forEach((cell, i) => {
        const text = String(cell ?? "").substring(0, 38);
        page.drawText(text, { x: margin + i * colW, y, size: fontSize, font, color: rgb(0, 0, 0) });
      });
      y -= lineH;
    }

    const bytes = await doc.save();
    downloadBlob(bytes, slug(label) + ".pdf", "application/pdf");
  });

  // ── DOCX ────────────────────────────────────────────────────────────────────
  document.getElementById("btn-docx").addEventListener("click", async () => {
    if (!activeDataset) return;
    const { columns, rows, label } = activeDataset;
    const { Document, Table, TableRow, TableCell, Paragraph, TextRun, Packer, WidthType } = await import("docx");

    function makeCell(text, bold = false) {
      return new TableCell({
        children: [new Paragraph({ children: [new TextRun({ text: String(text ?? ""), bold })] })],
      });
    }

    const table = new Table({
      width: { size: 100, type: WidthType.PERCENTAGE },
      rows: [
        new TableRow({ tableHeader: true, children: columns.map((c) => makeCell(c, true)) }),
        ...rows.map((row) => new TableRow({ children: row.map((c) => makeCell(c)) })),
      ],
    });

    const docx = new Document({
      sections: [{
        children: [
          new Paragraph({ children: [new TextRun({ text: `DLP Test — ${label}`, bold: true, size: 28 })] }),
          new Paragraph({ children: [new TextRun({ text: "Fabricated test data. Not real PII.", size: 18, color: "888888" })] }),
          new Paragraph({ text: "" }),
          table,
        ],
      }],
    });

    const blob = await Packer.toBlob(docx);
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url;
    a.download = slug(label) + ".docx";
    a.click();
    URL.revokeObjectURL(url);
  });

  // ── Utilities ────────────────────────────────────────────────────────────────
  function slug(label) {
    return "dlptest-" + label.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
  }

  function downloadBlob(data, filename, mime) {
    const blob = new Blob([data], { type: mime });
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url;
    a.download = filename;
    a.click();
    URL.revokeObjectURL(url);
  }
</script>
