---
import BaseLayout from "@/layouts/BaseLayout.astro";
import CyberhavenAdSlot from "@/components/CyberhavenAdSlot.astro";
import { FIELD_TYPE_DEFS } from "@/lib/data-generator";
import type { FieldTypeKey } from "@/lib/data-generator";

// Build grouped options for the type <select>
const groups: Record<string, { key: FieldTypeKey; label: string }[]> = {};
for (const [key, def] of Object.entries(FIELD_TYPE_DEFS) as [FieldTypeKey, { label: string; group: string }][]) {
  if (!groups[def.group]) groups[def.group] = [];
  groups[def.group].push({ key, label: def.label });
}
const GROUP_ORDER = ["Basic", "US PII / PCI", "US Specialized", "International"];

const defaultFields: { name: string; type: FieldTypeKey }[] = [
  { name: "id",         type: "row-number" },
  { name: "first_name", type: "first-name" },
  { name: "last_name",  type: "last-name"  },
  { name: "email",      type: "email"      },
  { name: "gender",     type: "gender"     },
  { name: "ip_address", type: "ip-v4"      },
];
---
<BaseLayout
  title="Data Generator"
  description="Build a custom dataset from any combination of PII, PCI, HIPAA, and other field types. Generate synthetic test data for DLP testing."
>
  <h1>Data Generator</h1>
  <p>
    Add fields, choose their types, and generate synthetic test data for DLP testing.
    All values are fabricated. Use a seed to reproduce the exact same dataset.
  </p>

  <CyberhavenAdSlot page="sample-data-tab">

  <!-- Field builder table -->
  <div class="builder-wrap">
    <table class="builder-table" id="builder-table">
      <thead>
        <tr>
          <th class="col-drag" aria-label="Drag to reorder"></th>
          <th class="col-name">Field Name</th>
          <th class="col-type">Type</th>
          <th class="col-blank" colspan="2">Options</th>
          <th class="col-actions"></th>
        </tr>
      </thead>
      <tbody id="builder-body">
        {defaultFields.map(({ name, type }) => (
          <tr class="builder-row" draggable="true" data-field-name={name} data-field-type={type}>
            <td class="col-drag drag-handle" aria-label="Drag handle">⠿</td>
            <td class="col-name">
              <input type="text" class="field-name-input" value={name} maxlength="50" aria-label="Field name" />
            </td>
            <td class="col-type">
              <select class="field-type-select" aria-label="Field type">
                {GROUP_ORDER.map((g) => (
                  <optgroup label={g}>
                    {(groups[g] ?? []).map(({ key, label }) => (
                      <option value={key} selected={key === type}>{label}</option>
                    ))}
                  </optgroup>
                ))}
              </select>
            </td>
            <td class="col-blank-label">
              <span class="delim-group">
                <span class="option-label">delim:</span>
                <input type="text" class="delim-input" maxlength="5" aria-label="Custom delimiter" />
                <label class="none-label">
                  <input type="checkbox" class="delim-none-check" aria-label="No delimiter" />
                  none
                </label>
              </span>
              blank:
            </td>
            <td class="col-blank-input">
              <span class="blank-pct-wrap">
                <input type="number" class="blank-pct-input" value="0" min="0" max="100" aria-label="Blank percent" />
                <span class="pct-sign">%</span>
              </span>
            </td>
            <td class="col-remove">
              <button type="button" class="btn-remove" aria-label="Remove field">✕</button>
            </td>
          </tr>
        ))}
      </tbody>
    </table>

    <button type="button" id="add-field-btn" class="btn-add-field">+ Add another field</button>
  </div>

  <!-- Generate controls -->
  <form id="generate-form" class="generate-form">
    <div class="generate-controls">
      <label class="control-group">
        <span class="control-label">Row count <span class="muted">(1–500)</span></span>
        <input type="number" name="count" id="count-input" value="50" min="1" max="500" />
      </label>

      <label class="control-group">
        <span class="control-label">Seed <span class="muted">(optional — leave blank for random)</span></span>
        <input type="number" name="seed" id="seed-input" placeholder="e.g. 42" />
      </label>
    </div>

    <div class="generate-actions">
      <button type="submit" id="generate-btn">Generate</button>
      <button type="button" id="download-csv-btn" class="btn-secondary">Download CSV</button>
      <button type="button" id="download-json-btn" class="btn-secondary">Download JSON</button>
    </div>
  </form>

  <p id="generate-status" class="muted" aria-live="polite"></p>

  </CyberhavenAdSlot>

  <div id="generate-results" hidden>
    <p id="seed-echo" class="muted small"></p>
    <div class="table-scroll">
      <table id="results-table">
        <thead id="results-head"></thead>
        <tbody id="results-body"></tbody>
      </table>
    </div>
  </div>
</BaseLayout>

<style>
  /* ── Builder table ─────────────────────────────────────────────────────────── */
  .builder-wrap {
    margin: 1.5rem 0 0;
  }
  .builder-table {
    width: 100%;
    border-collapse: collapse;
    table-layout: auto;
  }
  .builder-table thead th {
    text-align: left;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--muted, #888);
    padding: 0.3rem 0.5rem 0.5rem;
    border-bottom: 1px solid var(--border);
  }
  .builder-table thead th.col-drag { width: 1.5rem; }
  .builder-table thead th.col-name { width: 26%; }
  .builder-table thead th.col-type { width: 34%; }
  .builder-table thead th.col-blank { width: 1px; white-space: nowrap; }
  .builder-table thead th.col-actions { width: 1px; }

  .builder-row td {
    padding: 0.35rem 0.5rem;
    vertical-align: middle;
  }
  .builder-row:hover { background: var(--bg-elev); }
  .builder-row.drag-over { outline: 2px dashed var(--border); }
  .builder-row.dragging { opacity: 0.4; }

  .drag-handle {
    cursor: grab;
    color: var(--muted, #888);
    font-size: 1.1rem;
    user-select: none;
    text-align: center;
    width: 1.5rem;
  }
  .drag-handle:active { cursor: grabbing; }

  .field-name-input,
  .field-type-select {
    width: 100%;
    padding: 0.38rem 0.55rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-elev);
    color: var(--text);
    font-size: 0.92rem;
    font-family: monospace;
    box-sizing: border-box;
  }
  .field-type-select { font-family: inherit; }

  .col-blank-label {
    font-size: 0.85rem;
    color: var(--muted, #888);
    white-space: nowrap;
    padding-right: 0.25rem;
    vertical-align: middle;
  }
  .delim-group {
    display: none;
    align-items: center;
    gap: 0.3rem;
    margin-bottom: 0.3rem;
    white-space: nowrap;
  }
  .delim-group.is-visible {
    display: flex;
  }
  .option-label {
    font-size: 0.85rem;
    color: var(--muted, #888);
  }
  .delim-input {
    width: 2.5rem;
    padding: 0.25rem 0.3rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-elev);
    color: var(--text);
    font-size: 0.85rem;
    font-family: monospace;
    text-align: center;
  }
  .delim-input:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }
  .none-label {
    display: flex;
    align-items: center;
    gap: 0.2rem;
    font-size: 0.82rem;
    color: var(--muted, #888);
    cursor: pointer;
    user-select: none;
  }
  .blank-pct-wrap {
    display: flex;
    align-items: center;
    gap: 0.2rem;
  }
  .blank-pct-input {
    width: 4rem;
    padding: 0.38rem 0.4rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-elev);
    color: var(--text);
    font-size: 0.92rem;
    text-align: right;
  }
  .pct-sign {
    font-size: 0.85rem;
    color: var(--muted, #888);
  }

  .btn-remove {
    padding: 0.3rem 0.55rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: transparent;
    color: var(--muted, #888);
    cursor: pointer;
    font-size: 0.9rem;
    line-height: 1;
  }
  .btn-remove:hover { color: var(--text); border-color: var(--text); }

  .btn-add-field {
    margin-top: 0.6rem;
    padding: 0.4rem 0.85rem;
    border: 1px dashed var(--border);
    border-radius: var(--radius);
    background: transparent;
    color: var(--muted, #888);
    cursor: pointer;
    font-size: 0.9rem;
  }
  .btn-add-field:hover { color: var(--text); border-color: var(--text); }

  /* ── Generate controls ─────────────────────────────────────────────────────── */
  .generate-form { margin: 1.25rem 0; }
  .generate-controls {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 1rem;
  }
  .control-group {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .control-label {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text);
  }
  .generate-controls input[type="number"] {
    padding: 0.4rem 0.6rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-elev);
    color: var(--text);
    font-size: 0.95rem;
    min-width: 12rem;
  }
  .generate-actions { display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .btn-secondary {
    background: var(--bg-elev);
    color: var(--text);
    border: 1px solid var(--border);
  }
  .btn-secondary:disabled {
    opacity: 0.6;
    cursor: wait;
  }

  .table-scroll { overflow-x: auto; }

  :global(.copy-col) {
    width: 1%;
    white-space: nowrap;
    text-align: center;
    padding-left: 0.5rem !important;
    padding-right: 0.5rem !important;
  }
  :global(.copy-btn) {
    font-size: 0.72rem;
    padding: 0.18rem 0.5rem;
    background: var(--bg-elev);
    color: var(--text-dim);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    cursor: pointer;
    transition: color 0.15s, border-color 0.15s;
    line-height: 1.4;
  }
  :global(.copy-btn:hover) {
    color: var(--text);
    border-color: color-mix(in srgb, var(--border) 50%, var(--accent));
  }
  :global(.copy-btn.copied) {
    color: var(--accent);
    border-color: var(--accent);
  }

  #results-table {
    min-width: 100%;
    width: max-content;
    table-layout: fixed;
  }
</style>

<script>
  // ── Type registry (mirrors FIELD_TYPE_DEFS keys, used for default name suggestions) ──
  const DEFAULT_NAMES: Record<string, string> = {
    "row-number":      "id",
    "first-name":      "first_name",
    "last-name":       "last_name",
    "full-name":       "full_name",
    "gender":          "gender",
    "email":           "email",
    "ip-v4":           "ip_address",
    "ssn":             "ssn",
    "credit-card":     "credit_card_number",
    "dob":             "date_of_birth",
    "phone":           "phone",
    "zip":             "zip_code",
    "card-expiry":     "card_expiry",
    "mrn":             "mrn",
    "icd10":           "icd10_code",
    "cpt":             "cpt_code",
    "routing-number":  "routing_number",
    "account-number":  "account_number",
    "npi":             "npi",
    "dea-number":      "dea_number",
    "specialty":       "specialty",
    "us-state":        "state",
    "dl-number":       "dl_number",
    "uk-nin":          "uk_nin",
    "nhs-number":      "nhs_number",
    "canada-sin":      "sin",
    "canada-province": "province",
    "passport-number": "passport_number",
    "country":         "country",
    "eu-vat":          "eu_vat_number",
    "iban":            "iban",
  };

  // Columns rendered in <code> tags in the results table
  const CODE_COLUMNS = new Set([
    "ssn", "credit_card_number", "mrn", "routing_number", "account_number",
    "icd10_code", "cpt_code", "npi", "dea_number", "uk_nin", "nhs_number", "sin",
    "passport_number", "eu_vat_number", "iban",
  ]);

  type DatasetRow = Record<string, string>;
  interface GenerateResult {
    rows: DatasetRow[];
    columns: string[];
    seed: number;
    count: number;
  }

  let lastResult: GenerateResult | null = null;

  function collectFieldsPayload(): Record<string, unknown> {
    const countInput = document.getElementById("count-input") as HTMLInputElement;
    const seedInput  = document.getElementById("seed-input")  as HTMLInputElement;
    const count = Math.max(1, Math.min(500, parseInt(countInput.value, 10) || 50));
    const rawSeed = seedInput.value.trim();
    const seed = rawSeed !== "" ? parseInt(rawSeed, 10) : undefined;
    const fields = getRows().map((row) => {
      const noneCheck  = row.querySelector<HTMLInputElement>(".delim-none-check")!;
      const delimInput = row.querySelector<HTMLInputElement>(".delim-input")!;
      const fieldObj: Record<string, unknown> = {
        name:     (row.querySelector<HTMLInputElement>(".field-name-input")!.value.trim() || "field"),
        type:      row.querySelector<HTMLSelectElement>(".field-type-select")!.value,
        blankPct: parseInt(row.querySelector<HTMLInputElement>(".blank-pct-input")!.value || "0", 10) || 0,
      };
      if (noneCheck.checked) {
        fieldObj["delimiter"] = "";
      } else if (delimInput.value) {
        fieldObj["delimiter"] = delimInput.value;
      }
      return fieldObj;
    });
    const payload: Record<string, unknown> = { fields, count };
    if (seed !== undefined && !isNaN(seed)) payload["seed"] = seed;
    return payload;
  }

  async function fetchCurrentData(): Promise<GenerateResult> {
    if (lastResult) return lastResult;
    const res = await fetch("/api/generate-custom/", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(collectFieldsPayload()),
    });
    if (!res.ok) {
      const err = await res.json().catch(() => ({})) as Record<string, unknown>;
      throw new Error(String(err["error"] ?? res.statusText));
    }
    const result = (await res.json()) as GenerateResult;
    lastResult = result;
    return result;
  }

  function setDownloadBtnLoading(btn: HTMLButtonElement, loading: boolean) {
    btn.disabled = loading;
  }

  // ── Builder DOM helpers ──────────────────────────────────────────────────────

  const DELIM_DEFAULTS: Record<string, string> = {
    "ssn": "-", "credit-card": "-", "dob": "/", "phone": "",
    "card-expiry": "/", "mrn": "-", "uk-nin": " ", "nhs-number": " ", "canada-sin": "-",
  };

  const tbody = document.getElementById("builder-body") as HTMLTableSectionElement;
  const addFieldBtn = document.getElementById("add-field-btn") as HTMLButtonElement;

  function getRows(): HTMLTableRowElement[] {
    return Array.from(tbody.querySelectorAll<HTMLTableRowElement>(".builder-row"));
  }

  function enforceRemoveButtons() {
    const rows = getRows();
    rows.forEach((r) => {
      const btn = r.querySelector<HTMLButtonElement>(".btn-remove")!;
      btn.disabled = rows.length === 1;
    });
  }

  function makeRow(type: string = "first-name", name?: string): HTMLTableRowElement {
    // Clone an existing row so Astro's scoped CSS attribute is inherited
    const template = tbody.querySelector<HTMLTableRowElement>(".builder-row")!;
    const tr = template.cloneNode(true) as HTMLTableRowElement;
    tr.draggable = true;

    tr.querySelector<HTMLInputElement>(".field-name-input")!.value = name ?? DEFAULT_NAMES[type] ?? type;
    tr.querySelector<HTMLSelectElement>(".field-type-select")!.value = type;
    tr.querySelector<HTMLInputElement>(".blank-pct-input")!.value = "0";
    tr.querySelector<HTMLInputElement>(".delim-input")!.value = "";
    (tr.querySelector<HTMLInputElement>(".delim-none-check")!).checked = false;
    (tr.querySelector<HTMLInputElement>(".delim-none-check")!).disabled = false;
    tr.querySelector<HTMLSpanElement>(".delim-group")!.classList.remove("is-visible");

    wireRow(tr);
    return tr;
  }

  function wireRow(tr: HTMLTableRowElement) {
    const removeBtn = tr.querySelector<HTMLButtonElement>(".btn-remove")!;
    removeBtn.addEventListener("click", () => {
      if (getRows().length > 1) {
        tr.remove();
        enforceRemoveButtons();
        lastResult = null;
      }
    });

    const typeSelect = tr.querySelector<HTMLSelectElement>(".field-type-select")!;
    const nameInput  = tr.querySelector<HTMLInputElement>(".field-name-input")!;
    const delimGroup = tr.querySelector<HTMLSpanElement>(".delim-group")!;
    const delimInput = tr.querySelector<HTMLInputElement>(".delim-input")!;
    const noneCheck  = tr.querySelector<HTMLInputElement>(".delim-none-check")!;

    function updateDelimVisibility() {
      const type = typeSelect.value;
      const isDelimType = Object.prototype.hasOwnProperty.call(DELIM_DEFAULTS, type);
      delimGroup.classList.toggle("is-visible", isDelimType);
      if (isDelimType) {
        const def = DELIM_DEFAULTS[type];
        if (def === " ") {
          delimInput.placeholder = "(space)";
        } else if (def === "") {
          delimInput.placeholder = "e.g. -";
        } else {
          delimInput.placeholder = def;
        }
      } else {
        delimInput.value = "";
        noneCheck.checked = false;
        delimInput.disabled = false;
      }
    }

    noneCheck.addEventListener("change", () => {
      if (noneCheck.checked) {
        delimInput.value = "";
        delimInput.disabled = true;
      } else {
        delimInput.disabled = false;
      }
      lastResult = null;
    });

    typeSelect.addEventListener("change", () => {
      const suggested = DEFAULT_NAMES[typeSelect.value];
      // Only auto-fill if the name still matches a known default (user hasn't customised it)
      const currentIsDefault = Object.values(DEFAULT_NAMES).includes(nameInput.value);
      if (suggested && currentIsDefault) nameInput.value = suggested;
      updateDelimVisibility();
    });

    updateDelimVisibility();

    // Drag-and-drop
    tr.addEventListener("dragstart", onDragStart);
    tr.addEventListener("dragover", onDragOver);
    tr.addEventListener("dragleave", onDragLeave);
    tr.addEventListener("drop", onDrop);
    tr.addEventListener("dragend", onDragEnd);
  }

  // Wire the server-rendered default rows
  getRows().forEach(wireRow);
  enforceRemoveButtons();

  addFieldBtn.addEventListener("click", () => {
    const row = makeRow("first-name");
    tbody.appendChild(row);
    enforceRemoveButtons();
    row.querySelector<HTMLInputElement>(".field-name-input")!.focus();
    lastResult = null;
  });

  // Invalidate cached result whenever field config or generation options change
  tbody.addEventListener("change", () => { lastResult = null; });
  tbody.addEventListener("input",  () => { lastResult = null; });
  document.getElementById("count-input")!.addEventListener("input", () => { lastResult = null; });
  document.getElementById("seed-input")!.addEventListener("input",  () => { lastResult = null; });

  // ── Drag-and-drop reorder ────────────────────────────────────────────────────

  let dragSrc: HTMLTableRowElement | null = null;

  function onDragStart(this: HTMLTableRowElement, e: DragEvent) {
    dragSrc = this;
    this.classList.add("dragging");
    e.dataTransfer!.effectAllowed = "move";
  }
  function onDragOver(this: HTMLTableRowElement, e: DragEvent) {
    e.preventDefault();
    e.dataTransfer!.dropEffect = "move";
    this.classList.add("drag-over");
  }
  function onDragLeave(this: HTMLTableRowElement) {
    this.classList.remove("drag-over");
  }
  function onDrop(this: HTMLTableRowElement, e: DragEvent) {
    e.preventDefault();
    this.classList.remove("drag-over");
    if (dragSrc && dragSrc !== this) {
      const rows = getRows();
      const srcIdx = rows.indexOf(dragSrc);
      const tgtIdx = rows.indexOf(this);
      if (srcIdx < tgtIdx) {
        tbody.insertBefore(dragSrc, this.nextSibling);
      } else {
        tbody.insertBefore(dragSrc, this);
      }
    }
  }
  function onDragEnd(this: HTMLTableRowElement) {
    this.classList.remove("dragging");
    getRows().forEach((r) => r.classList.remove("drag-over"));
    dragSrc = null;
  }

  // ── Generate form ────────────────────────────────────────────────────────────

  const form = document.getElementById("generate-form") as HTMLFormElement;
  const generateBtn = document.getElementById("generate-btn") as HTMLButtonElement;
  const statusEl = document.getElementById("generate-status") as HTMLElement;
  const resultsDiv = document.getElementById("generate-results") as HTMLDivElement;
  const resultsThead = document.getElementById("results-head") as HTMLTableSectionElement;
  const resultsTbody = document.getElementById("results-body") as HTMLTableSectionElement;
  const seedEcho = document.getElementById("seed-echo") as HTMLParagraphElement;
  const csvBtn = document.getElementById("download-csv-btn") as HTMLButtonElement;
  const jsonBtn = document.getElementById("download-json-btn") as HTMLButtonElement;

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    const formData = new FormData(form);
    const count = Math.max(1, Math.min(500, parseInt(formData.get("count") as string, 10) || 50));
    const rawSeed = (formData.get("seed") as string).trim();
    const seed = rawSeed !== "" ? parseInt(rawSeed, 10) : undefined;

    const fields = getRows().map((row) => {
      const noneCheck  = row.querySelector<HTMLInputElement>(".delim-none-check")!;
      const delimInput = row.querySelector<HTMLInputElement>(".delim-input")!;
      const fieldObj: Record<string, unknown> = {
        name:     (row.querySelector<HTMLInputElement>(".field-name-input")!.value.trim() || "field"),
        type:      row.querySelector<HTMLSelectElement>(".field-type-select")!.value,
        blankPct: parseInt(row.querySelector<HTMLInputElement>(".blank-pct-input")!.value || "0", 10) || 0,
      };
      if (noneCheck.checked) {
        fieldObj["delimiter"] = "";
      } else if (delimInput.value) {
        fieldObj["delimiter"] = delimInput.value;
      }
      return fieldObj;
    });

    generateBtn.disabled = true;
    statusEl.textContent = "Generating…";
    resultsDiv.hidden = true;

    try {
      const body: Record<string, unknown> = { fields, count };
      if (seed !== undefined && !isNaN(seed)) body["seed"] = seed;

      const res = await fetch("/api/generate-custom/", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(body),
      });

      if (!res.ok) {
        const err = await res.json().catch(() => ({})) as Record<string, unknown>;
        statusEl.textContent = `Error: ${String(err["error"] ?? res.statusText)}`;
        return;
      }

      const result = (await res.json()) as GenerateResult;
      lastResult = result;
      renderTable(result);
      seedEcho.textContent = `Generated with seed ${result.seed} — paste this seed to reproduce the exact dataset.`;
      resultsDiv.hidden = false;
      csvBtn.hidden = false;
      jsonBtn.hidden = false;
      statusEl.textContent = "";
    } catch (err) {
      statusEl.textContent = `Request failed: ${err instanceof Error ? err.message : "unknown error"}`;
    } finally {
      generateBtn.disabled = false;
    }
  });

  function makeCopyBtn(label: string, getText: () => string): HTMLButtonElement {
    const btn = document.createElement("button");
    btn.type = "button";
    btn.className = "copy-btn";
    btn.textContent = label;
    btn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(getText());
        btn.textContent = "Copied!";
        btn.classList.add("copied");
        setTimeout(() => { btn.textContent = label; btn.classList.remove("copied"); }, 1500);
      } catch {
        btn.textContent = "Error";
        setTimeout(() => { btn.textContent = label; }, 1500);
      }
    });
    return btn;
  }

  function renderTable(result: GenerateResult) {
    const colWidth = `${Math.max(8, Math.floor(100 / result.columns.length))}%`;

    // Header row + "Copy all" button
    const headerRow = document.createElement("tr");
    for (const col of result.columns) {
      const th = document.createElement("th");
      th.textContent = col;
      th.style.minWidth = "8rem";
      th.style.width = colWidth;
      headerRow.appendChild(th);
    }
    const copyAllTh = document.createElement("th");
    copyAllTh.className = "copy-col";
    copyAllTh.appendChild(makeCopyBtn("Copy all", () =>
      [...resultsTbody.querySelectorAll<HTMLElement>("tr")]
        .map((tr) =>
          [...tr.querySelectorAll<HTMLElement>("td:not(.copy-col)")]
            .map((c) => c.textContent?.trim() ?? "").join("\t")
        ).join("\n")
    ));
    headerRow.appendChild(copyAllTh);
    resultsThead.innerHTML = "";
    resultsThead.appendChild(headerRow);

    // Body rows + per-row "Copy" button
    resultsTbody.innerHTML = "";
    for (const row of result.rows) {
      const tr = document.createElement("tr");
      for (const col of result.columns) {
        const td = document.createElement("td");
        const value = String(row[col] ?? "");
        if (CODE_COLUMNS.has(col)) {
          const code = document.createElement("code");
          code.textContent = value;
          td.appendChild(code);
        } else {
          td.textContent = value;
        }
        tr.appendChild(td);
      }
      const copyTd = document.createElement("td");
      copyTd.className = "copy-col";
      copyTd.appendChild(makeCopyBtn("Copy", () =>
        [...tr.querySelectorAll<HTMLElement>("td:not(.copy-col)")]
          .map((c) => c.textContent?.trim() ?? "").join("\t")
      ));
      tr.appendChild(copyTd);
      resultsTbody.appendChild(tr);
    }
  }

  function clientCsv(result: GenerateResult): string {
    function escape(v: string): string {
      return v.includes(",") || v.includes('"') || v.includes("\n")
        ? `"${v.replace(/"/g, '""')}"` : v;
    }
    const header = result.columns.join(",");
    const body = result.rows
      .map((row) => result.columns.map((c) => escape(String(row[c] ?? ""))).join(","))
      .join("\n");
    return `${header}\n${body}`;
  }

  function downloadBlob(content: string, filename: string, mime: string) {
    const blob = new Blob([content], { type: mime });
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url;
    a.download = filename;
    a.click();
    URL.revokeObjectURL(url);
  }

  csvBtn.addEventListener("click", async () => {
    if (lastResult) {
      downloadBlob(clientCsv(lastResult), `dlptest-custom-seed${lastResult.seed}.csv`, "text/csv");
      return;
    }
    setDownloadBtnLoading(csvBtn, true);
    statusEl.textContent = "Generating…";
    try {
      const result = await fetchCurrentData();
      downloadBlob(clientCsv(result), `dlptest-custom-seed${result.seed}.csv`, "text/csv");
      statusEl.textContent = "";
    } catch (err) {
      statusEl.textContent = `Download failed: ${err instanceof Error ? err.message : "unknown error"}`;
    } finally {
      setDownloadBtnLoading(csvBtn, false);
    }
  });

  jsonBtn.addEventListener("click", async () => {
    if (lastResult) {
      downloadBlob(
        JSON.stringify(lastResult.rows, null, 2),
        `dlptest-custom-seed${lastResult.seed}.json`,
        "application/json"
      );
      return;
    }
    setDownloadBtnLoading(jsonBtn, true);
    statusEl.textContent = "Generating…";
    try {
      const result = await fetchCurrentData();
      downloadBlob(
        JSON.stringify(result.rows, null, 2),
        `dlptest-custom-seed${result.seed}.json`,
        "application/json"
      );
      statusEl.textContent = "";
    } catch (err) {
      statusEl.textContent = `Download failed: ${err instanceof Error ? err.message : "unknown error"}`;
    } finally {
      setDownloadBtnLoading(jsonBtn, false);
    }
  });
</script>
