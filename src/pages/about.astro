---
import BaseLayout from "@/layouts/BaseLayout.astro";
export const prerender = true;

// The person behind the site, for search engines and AI assistants. Guides
// point their author at this @id (src/pages/[slug]/index.astro).
const personJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": "https://dlptest.com/about/#brian-hileman",
  name: "Brian Hileman",
  url: "https://dlptest.com/about/",
  jobTitle: "Principal Solutions Architect",
  worksFor: { "@type": "Organization", name: "Ent", url: "https://ent.ai/" },
  knowsAbout: ["Data Loss Prevention", "Insider Risk Management", "CASB", "Data security"],
  sameAs: ["https://www.linkedin.com/in/brianhileman/"],
});
---
<BaseLayout title="About" description="DLP Test is created and maintained by Brian Hileman, who has over a decade of experience in data loss prevention and insider risk.">
  <script type="application/ld+json" set:html={personJsonLd} />
  <h1>About</h1>
  <p>
    DLPTest.com is a free resource for testing data loss prevention (DLP)
    software.
  </p>

  <section class="about-person">
    <h2>About me</h2>
    <p>
      I'm Brian Hileman. I have over a decade of experience in data protection,
      mostly Data Loss Prevention (DLP) and Insider Risk Management. I created
      and maintain DLPTest.com as a resource for evaluating and testing DLP.
    </p>
    <p>
      I'm currently a Principal Solutions Architect at Ent. Before that I spent
      four years at Cyberhaven, and I've also worked at Palo Alto Networks,
      Digital Guardian, and InteliSecure (acquired by Proofpoint), with hands-on
      experience across DLP, CASB, and data security strategy.
    </p>
    <p>
      I speak regularly at industry conferences, including ISSA, CSA, and RMISC,
      about protecting sensitive data.
    </p>
    <p>
      I work for Ent, a vendor in this market, and Ent advertises on this site.
    </p>
    <p class="about-links">
      <a class="linkedin-link" href="https://www.linkedin.com/in/brianhileman/" target="_blank" rel="noopener noreferrer">
        <svg class="linkedin-link__icon" aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
          <path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.86-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.36V9h3.41v1.56h.05c.47-.9 1.63-1.86 3.36-1.86 3.6 0 4.27 2.37 4.27 5.45v6.3zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.55C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0z"/>
        </svg>
        <span>Connect on LinkedIn</span>
      </a>
      <a class="button button-outline" href="/contact/">Contact me</a>
    </p>
  </section>

  <section class="about-person">
    <h2>Contributors</h2>
    <h3><a href="https://www.linkedin.com/in/iamzackhayes/" target="_blank" rel="noopener noreferrer">Zack Hayes</a></h3>
    <p>
      Zack started this project with me. He was an <a href="https://web.archive.org/web/20260222141140/https://yourpalzack.com/about/" target="_blank" rel="noopener noreferrer">SEO professional</a> from Rifle, Colorado, and a good friend. We were high school friends, and we knew each other for a very long time, through many different periods of our lives.
    </p>
    <p>
      Zack helped me start to understand what AI can do, and we chatted about it
      a lot. He was always building new things and pushing the limit. In my
      opinion he was an innovator, always ahead of the curve and plugged into
      what was happening. He could have been a massive success. He was
      successful, but in his own way.
    </p>
    <p>
      He also helped me move the site from WordPress to what it is now. We sat
      on a lot of calls and he walked me through it.
    </p>
    <p>
      He has since passed away, and I miss him.
    </p>
    <h3><a href="https://www.linkedin.com/in/cole-padula/" target="_blank" rel="noopener noreferrer">Cole Padula</a></h3>
    <p>
      Cole, who I worked with at Cyberhaven, helped me rebuild the site in 2026.
    </p>
  </section>

  <section class="about-person">
    <h2>Talks and writing</h2>
    <ul>
      <li>
        <a href="https://www.youtube.com/watch?v=LjQQ4D4rCAw" target="_blank" rel="noopener noreferrer">Securing Data in the GenAI Era</a> (talk, 2025)
      </li>
      <li>Your AI Coding Assistant Just Stole Your Source Code (talk, RMISC 2026)</li>
      <li>
        <a href="/the-hard-truth-about-dlp-why-endpoint-agents-are-essential/">The Hard Truth About DLP: Why Endpoint Agents Are Essential</a>
      </li>
      <li>
        <a href="/the-data-protection-platform-race-is-on/">The data protection platform race is on</a>
      </li>
    </ul>
  </section>

  <style>
    .about-person {
      max-width: 46rem;
      margin-top: 1.5rem;
    }
    .about-person p {
      line-height: 1.65;
    }
    .about-person h3 {
      margin-top: 1.5rem;
      margin-bottom: 0.4rem;
      font-size: 1.1rem;
    }
    .about-links {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.75rem;
      margin-top: 1.25rem;
    }
    .linkedin-link {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.55rem 0.9rem;
      border: 1px solid color-mix(in srgb, var(--accent) 30%, var(--border));
      border-radius: 999px;
      color: var(--accent);
      font-weight: 600;
      font-size: 0.95rem;
      text-decoration: none;
      transition: background var(--transition-fast), border-color var(--transition-fast), color var(--transition-fast);
    }
    .linkedin-link:hover {
      background: color-mix(in srgb, var(--accent) 10%, transparent);
      border-color: var(--accent);
      color: var(--accent);
    }
    .linkedin-link__icon {
      flex-shrink: 0;
    }
  </style>
</BaseLayout>
