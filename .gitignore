# Local FTP / file backups (may contain wp-config.php, uploads, secrets)
backup/

.DS_Store
node_modules/
.wrangler/
.dev.vars
.env
.env.*
!.env.example

# Astro build output and cache
dist/
.astro/

# Temp output of `npm run regex:validate` (compiles the pattern lib to check it)
.regexcheck/

# Local scratch caches for one-shot import scripts (regenerable from the source URLs)
scripts/news/cache/

# Generated by scripts/dlp-test-plan/build.py — regenerate, do not commit.
scripts/dlp-test-plan/*.xlsx

# Test data that cannot be committed: credential-shaped files (GitHub push protection
# rejects them on shape), nested git repositories, raw MCP responses and the MCP response
# cache. Build after a clone with: scripts/dlp-test-plan/test-data/tools/build.py local
scripts/dlp-test-plan/test-data/generated/
scripts/dlp-test-plan/test-data/tools/__pycache__/
