{
  "name": "dlptest.com",
  "private": true,
  "version": "0.1.0",
  "description": "DLP Test site — Astro on Cloudflare Workers (prod + staging via wrangler env)",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:staging": "CLOUDFLARE_ENV=staging astro build",
    "preview": "wrangler dev --config dist/server/wrangler.json",
    "sync": "astro sync",
    "check": "astro sync && tsc --noEmit",
    "deploy": "npm run build && wrangler deploy --config dist/server/wrangler.json",
    "deploy:staging": "npm run build:staging && wrangler deploy --config dist/server/wrangler.json",
    "news:test-key": "node scripts/news/test-cursor-api-key.mjs",
    "news:cloud-draft": "node scripts/news/run-cloud-draft.mjs",
    "r2:create": "wrangler r2 bucket create dlptest-downloads"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.2",
    "@astrojs/cloudflare": "^13.5.1",
    "@astrojs/sitemap": "^3.7.2",
    "astro": "^6.3.3",
    "docx": "^9.6.1",
    "pdf-lib": "^1.17.1",
    "rehype-external-links": "^3.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250425.0",
    "aws4fetch": "^1.0.20",
    "typescript": "^5.8.3",
    "wrangler": "^4.92.0"
  }
}
